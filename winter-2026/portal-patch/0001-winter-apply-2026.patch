+// 冬期講習申込の DB 関数を、実際の SQL（PGlite）で動かして確認する。本番DBには接続しない。
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { randomUUID } from 'node:crypto';
+import { PGlite } from '@electric-sql/pglite';
+import {
+  DEMO_IDS, DEMO_GRANT_OFFICE_VIEW, demoDatabaseSql, sqlRpc, verificationBody,
+} from '../seasonal-apply-demo-db';
+import {
+  loadAdminBoard, loadPublicCatalog, modifyApplication, submitApplication, updateCourseControl, updateSettings, type Rpc,
+} from '../seasonal-apply-service';
+import { priceFamily } from '../seasonal-apply-pricing';
+import type { PortalCourse } from '../seasonal-apply-catalog';
+
+const migration = readFileSync('supabase/migrations/20261021090000_seasonal_apply_capacity.sql', 'utf8');
+const snapshot = JSON.parse(readFileSync('scripts/seasonal-apply-demo/portal-catalog-2026-10-20.json', 'utf8')) as {
+  courses: PortalCourse[]; teachers: Record<string, string>; afternoonStart: string;
+};
+const { campus, principal, office } = DEMO_IDS;
+const NOW = new Date('2026-11-01T15:00:00Z');
+
+async function setup(opts: { published?: boolean; scenario?: 'portal' | 'verification' } = {}) {
+  const db = new PGlite();
+  const courses = opts.scenario === 'portal' ? snapshot.courses : verificationBody(snapshot.courses);
+  await db.exec(demoDatabaseSql(migration, { body: { courses, afternoonStart: snapshot.afternoonStart }, teachers: snapshot.teachers, published: opts.published ?? true }));
+  const rpc: Rpc = sqlRpc((sql, params) => db.query(sql, params) as never);
+  return { db, rpc };
+}
+
+async function open(rpc: Rpc) {
+  const board = await loadAdminBoard(rpc, campus, principal, NOW);
+  await updateSettings(rpc, campus, principal, randomUUID(), board.settings.revision, 'open', null, '受付開始');
+}
+
+const title = (t: string) => {
+  const c = snapshot.courses.filter(x => x.title === t);
+  assert.ok(c.length >= 1, t);
+  return c[0].id;
+};
+const KEISAN_TG = title('計算マスターへの道【第2章①】');       // サンクスギビング 小4-6 集団
+const KEISAN_W1 = title('計算マスターへの道　1章①');           // 冬期1 小4-6 集団
+const TANKEN = title('算数・数学探検隊　〜作って、試して、算数・数学の不思議を発見しよう！〜'); // 冬期1 9:00 小4-中3
+const COASTER_W1 = 'ded687f5-0fa2-4cd5-afb1-0f56f1735c87';   // 冬期1 9:00（探検隊と同時刻）
+const KOBETSU_TG = title('個別');                               // サンクスギビングの個別（下書き→検証で個別）
+const KOBETSU_READY = 'bbd26a63-d62d-4dbf-9e00-721548d6fd25';   // 冬期2 個別（ポータルで確定済み）
+const HANGA = '191ec094-2acd-4605-9656-ea4ad7726caf';          // 版画 14:00-17:00 ×3（2コマ連続）
