+import Link from 'next/link';
+import { redirect } from 'next/navigation';
+import { getCurrentStaffSession } from '@/lib/staff-auth';
+import { seasonalApplyDemoEnabled } from '@/lib/seasonal-apply-server';
+import ApplicationsAdmin from './ApplicationsAdmin';
+import { adminCsv, adminLoad, adminModifyApplication, adminUpdateCourse, adminUpdateSettings, type DemoActor } from './actions';
+
+export const dynamic = 'force-dynamic';
+export const metadata = { title: '冬期講習2026 申込・定員管理 — 職員ポータル' };
+
+export default async function SeasonalApplicationsPage({ searchParams }: { searchParams: Promise<{ as?: string }> }) {
+  const demo = seasonalApplyDemoEnabled();
+  const sp = await searchParams;
+  let demoActor: DemoActor | undefined;
+  if (demo) {
+    demoActor = sp.as === 'office' ? 'office' : 'principal';
+  } else {
+    const staff = await getCurrentStaffSession().catch(() => null);
+    if (!staff) redirect('/portal');
+    if (!staff.permissions.includes('seasonal_applications.view')) {
+      return <main style={{ padding: 24, background: '#fff', color: '#18324a', minHeight: '100vh' }}><Link href="/portal">職員ポータルへ</Link><p>「季節講習の申込を閲覧」の権限が必要です。校長に権限設定を確認してください。</p></main>;
+    }
+  }
+  const initial = await adminLoad(demoActor);
+  return (
+    <ApplicationsAdmin
+      initial={initial}
+      demoActor={demoActor}
+      actions={{ load: adminLoad, settings: adminUpdateSettings, course: adminUpdateCourse, modify: adminModifyApplication, csv: adminCsv }}
+      links={{ portal: demo ? null : '/portal', timetable: demo ? null : '/timetable/calendar?seasonal=2026', publicPage: '/winter' }}
+    />
+  );
+}
