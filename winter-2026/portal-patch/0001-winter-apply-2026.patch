+function describe(d: Record<string, unknown>): string {
+  const parts: string[] = [];
+  const before = d.before as Record<string, unknown> | undefined; const after = d.after as Record<string, unknown> | undefined;
+  if (before && after) {
+    const label: Record<string, string> = { capacity: '定員', manualState: '受付', priceMultiplier: '料金倍率', subject: '教科', phase: '受付状態', closesAt: '締切日時' };
+    for (const k of Object.keys(after)) {
+      if (JSON.stringify(before[k]) !== JSON.stringify(after[k])) {
+        const v = (x: unknown) => x == null ? '初期値/なし' : x === 'closed' ? '締切' : x === 'open' ? '受付' : x === 'preparing' ? '準備中' : String(x);
+        parts.push(`${label[k] ?? k}: ${v(before[k])} → ${v(after[k])}`);
+      }
+    }
+  }
+  if (d.total != null) parts.push(`合計 ${formatUsd(Number(d.total))}`);
+  if (d.totalBefore != null) parts.push(`合計 ${formatUsd(Number(d.totalBefore))} → ${formatUsd(Number(d.totalAfter))}`);
+  if (d.cancelledItems) parts.push(`取消 ${d.cancelledItems}講座`);
+  if (d.addedItems) parts.push(`追加 ${d.addedItems}講座`);
+  if (d.reason) parts.push(`理由: ${d.reason}`);
+  return parts.join('／');
+}
