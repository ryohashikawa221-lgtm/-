@@ -0,0 +1,154 @@
+/**
+ * 冬期講習申込（20261021090000_seasonal_apply_capacity.sql）の同時実行テスト。本番DBには接続しない。
+ * 使い捨ての PostgreSQL 17 クラスタ（TEST_PG_BIN の initdb/pg_ctl、非公開の Unix ソケット）を作り、
+ * 別々の psql 接続を同時刻に一斉に走らせる。DB関数は service_role で呼び、付与（grant）も同時に確認する。
+ *   1) 残り3席に20家庭が同時申込 → 成功はちょうど3件、保存も3件
+ *   2) 同じ操作IDで10回同時送信（二重クリック・再試行）→ 申込は1件、全員が同じ受付番号
+ *   3) 満席講座で「1件取消」と「5件申込」を同時 → 定員を超えない
+ *   4) 「手動締切」と「10件申込」を同時 → 締切の確定後に記録された申込はない
+ *   5) 保護者・匿名ロールからは DB 関数を直接呼べない
+ * 既存のサーバーを使う場合（ローカル）: SEASONAL_APPLY_PG="-h /var/tmp/pgwinter -p 54329 -U postgres"
+ */
+import { spawn, execFileSync, spawnSync } from 'node:child_process';
+import { mkdtempSync, readFileSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import assert from 'node:assert/strict';
+import { DEMO_IDS, demoDatabaseSql } from '../lib/seasonal-apply-demo-db';
+import { priceFamily } from '../lib/seasonal-apply-pricing';
+import type { PortalCourse } from '../lib/seasonal-apply-catalog';
+
+const dir = mkdtempSync(join(tmpdir(), 'seasonal-apply-'));
+const bin = process.env.TEST_PG_BIN || '/usr/lib/postgresql/17/bin';
+const port = '55617';
+const own = !process.env.SEASONAL_APPLY_PG;
+const conn = own ? ['-h', dir, '-p', port, '-U', 'postgres'] : process.env.SEASONAL_APPLY_PG!.split(' ');
+const env = { ...process.env };
+for (const key of Object.keys(env)) if (/^(PG|SUPABASE|DATABASE_URL|NEXT_PUBLIC_SUPABASE)/.test(key)) delete env[key];
+function startCluster() {
+  if (!own) return;
+  execFileSync(join(bin, 'initdb'), ['-D', join(dir, 'data'), '-U', 'postgres', '--auth-local=trust', '--auth-host=reject', '--no-locale', '--encoding=UTF8'], { env, stdio: 'ignore' });
+  execFileSync(join(bin, 'pg_ctl'), ['-D', join(dir, 'data'), '-o', `-p ${port} -k ${dir} -c listen_addresses='' -c max_connections=100 -c TimeZone=UTC`, '-l', join(dir, 'postgres.log'), '-w', 'start'], { env, stdio: 'ignore' });
+}
+function stopCluster() {
+  if (!own) return;
+  try { execFileSync(join(bin, 'pg_ctl'), ['-D', join(dir, 'data'), '-m', 'immediate', 'stop'], { env, stdio: 'ignore' }); } catch { /* already stopped */ }
+}
+const DB = `winter_conc_${Date.now()}`;
+const psqlBin = own ? join(bin, 'psql') : 'psql';
+const psql = (args: string[], db = DB) => execFileSync(psqlBin, ['-X', ...conn, '-d', db, '-v', 'ON_ERROR_STOP=1', '-qAt', ...args], { encoding: 'utf8', env });
+
+const snapshot = JSON.parse(readFileSync('scripts/seasonal-apply-demo/portal-catalog-2026-10-20.json', 'utf8')) as {
+  courses: PortalCourse[]; teachers: Record<string, string>; afternoonStart: string;
+};
+const COURSE = 'b30f8633-be06-46c8-baa2-05e26543afb1'; // 計算マスターへの道 1章①（ポータルで確定済み・集団）
+const { campus, principal } = DEMO_IDS;
+
+function runParallel(sqls: string[], startInMs = 1500): Promise<string[]> {
+  const at = new Date(Date.now() + startInMs).toISOString();
+  return Promise.all(sqls.map((sql, i) => new Promise<string>((resolve, reject) => {
+    const f = join(dir, `w${i}-${randomUUID()}.sql`);
+    // 全接続を同じ時刻まで待たせてから一斉に実行する
+    writeFileSync(f, `select pg_sleep(greatest(0, extract(epoch from (timestamptz '${at}' - clock_timestamp()))));\nset role service_role;\n${sql}\n`);
+    const p = spawn(psqlBin, ['-X', ...conn, '-d', DB, '-v', 'ON_ERROR_STOP=1', '-qAt', '-f', f], { env });
+    let out = ''; let err = '';
+    p.stdout.on('data', d => { out += d; });
+    p.stderr.on('data', d => { err += d; });
+    p.on('close', code => code === 0 ? resolve(out.trim().split('\n').pop() ?? '') : reject(new Error(err)));
+  })));
+}
+
+const lit = (v: unknown) => `'${JSON.stringify(v).replace(/'/g, "''")}'`;
+
+function submitSql(op: string, email: string, child: string) {
+  const pricing = priceFamily([{ key: '1', grade: '小4', courses: [{ courseId: COURSE, countUnits: 1, priceMultiplier: 1 }] }]);
+  const intent = { email, child };
+  const request = {
+    intent, publishedRevision: 1,
+    guardian: { name: '保護者', email, phone: '000', affiliation: '', note: '' },
+    children: [{ position: 1, name: child, grade: '小4', items: [{ courseId: COURSE, countUnits: 1, priceMultiplier: 1, controlRevision: ctlRev() }] }],
+    pricing, total: pricing.total,
+  };
+  return `select public.portal_seasonal_apply_submit('${campus}', '${op}', ${lit(request)}::jsonb);`;
+}
+
+function ctlRev(): number {
+  return Number(psql(['-c', `select coalesce((select revision from public.seasonal_apply_course_controls where course_id='${COURSE}'),0)`]));
+}
+const active = () => Number(psql(['-c', `select count(*) from public.seasonal_apply_items where course_id='${COURSE}' and state='active'`]));
+
+async function main() {
+  startCluster();
+  psql(['-c', `create database ${DB}`], 'postgres');
+  try {
+    const schema = join(dir, 'schema.sql');
+    writeFileSync(schema, demoDatabaseSql(readFileSync('supabase/migrations/20261021090000_seasonal_apply_capacity.sql', 'utf8'),
+      { body: { courses: snapshot.courses, afternoonStart: snapshot.afternoonStart }, teachers: snapshot.teachers, published: true }));
+    psql(['-f', schema]);
+    psql(['-c', `set role service_role; select public.portal_seasonal_apply_settings_update('${campus}','${principal}','${randomUUID()}',0,'open',null,'test')`]);
+    psql(['-c', `set role service_role; select public.portal_seasonal_apply_course_update('${campus}','${principal}','${randomUUID()}','${COURSE}',0,'{"capacity":3}'::jsonb)`]);
+
+    // 5) 保護者（authenticated）・匿名（anon）からは直接呼べない
+    for (const role of ['anon', 'authenticated']) {
+      const r = spawnSync(psqlBin, ['-X', ...conn, '-d', DB, '-v', 'ON_ERROR_STOP=1', '-qAt', '-c', `set role ${role}; select public.portal_seasonal_apply_catalog('${campus}')`], { encoding: 'utf8', env });
+      assert.notEqual(r.status, 0, `${role} must not execute`);
+      assert.match(r.stderr, /permission denied/);
+    }
+    console.log('5) anon / authenticated からの直接呼び出しは拒否');
+
+    // 1) 3席に20件同時
+    const r1 = await runParallel(Array.from({ length: 20 }, (_, i) => submitSql(randomUUID(), `p${i}@example.com`, `子${i}`)));
+    const ok1 = r1.filter(x => JSON.parse(x).ok).length;
+    console.log(`1) 定員3に20件同時申込: 成功 ${ok1} 件 / 保存 ${active()} 件`);
+    assert.equal(ok1, 3);
+    assert.equal(active(), 3);
+    assert.ok(r1.filter(x => !JSON.parse(x).ok).every(x => JSON.parse(x).issues[0].reason === 'full'));
+
+    // 2) 同じ操作IDを10回同時（定員を広げてから）
+    psql(['-c', `set role service_role; select public.portal_seasonal_apply_course_update('${campus}','${principal}','${randomUUID()}','${COURSE}',${ctlRev()},'{"capacity":10}'::jsonb)`]);
+    const op = randomUUID();
+    const sql = submitSql(op, 'same@example.com', '同じ子');
+    const r2 = await runParallel(Array.from({ length: 10 }, () => sql));
+    const receipts = new Set(r2.map(x => JSON.parse(x).receiptNo));
+    const apps = Number(psql(['-c', `select count(*) from public.seasonal_apply_applications where operation_id='${op}'`]));
+    console.log(`2) 同じ操作IDを10回同時送信: 申込 ${apps} 件 / 受付番号 ${[...receipts].join(',')} / 再送扱い ${r2.filter(x => JSON.parse(x).replay).length} 件`);
+    assert.equal(apps, 1);
+    assert.equal(receipts.size, 1);
+    assert.ok(r2.every(x => JSON.parse(x).ok));
+
+    // 3) 満席にしてから「取消1件」と「申込5件」を同時
+    const fill = Math.max(0, 10 - active());
+    await runParallel(Array.from({ length: fill }, (_, i) => submitSql(randomUUID(), `fill${i}@example.com`, `満${i}`)), 300);
+    assert.equal(active(), 10);
+    const victim = psql(['-c', `select a.id||'|'||a.revision||'|'||i.id from public.seasonal_apply_items i join public.seasonal_apply_applications a on a.id=i.application_id where i.course_id='${COURSE}' and i.state='active' order by a.submitted_at limit 1`]);
+    const [appId, rev, itemId] = victim.trim().split('|');
+    const zero = { children: [{ key: '1', listPrice: 0, countDiscount: 0, tuition: 0, siblingRate: 0, siblingDiscount: 0, amount: 0 }], total: 0 };
+    const cancelSql = `select public.portal_seasonal_apply_modify('${campus}','${principal}','${randomUUID()}','${appId}',${rev},array['${itemId}']::uuid[],null,'同時取消テスト',${lit(zero)}::jsonb);`;
+    const r3 = await runParallel([cancelSql, ...Array.from({ length: 5 }, (_, i) => submitSql(randomUUID(), `race${i}@example.com`, `競${i}`))]);
+    console.log('   取消結果:', r3[0].slice(0, 160));
+    const ok3 = r3.slice(1).filter(x => JSON.parse(x).ok).length;
+    console.log(`3) 満席で取消1件と申込5件を同時: 申込成功 ${ok3} 件 / 最終 ${active()} 件（定員10）`);
+    assert.ok(active() <= 10);
+    assert.ok(ok3 <= 1);
+
+    // 4) 手動締切と申込10件を同時
+    const closeSql = `select public.portal_seasonal_apply_course_update('${campus}','${principal}','${randomUUID()}','${COURSE}',${ctlRev()},'{"capacity":50,"manualState":"closed"}'::jsonb);`;
+    const before = active();
+    const r4 = await runParallel([closeSql, ...Array.from({ length: 10 }, (_, i) => submitSql(randomUUID(), `close${i}@example.com`, `締${i}`))]);
+    // 操作履歴の通し番号はロック下で採番されるので、確定順を表す。締切より後に記録された申込が無いことを確認する。
+    const closeAudit = Number(psql(['-c', `select max(id) from public.seasonal_apply_audit where action='course_control_changed'`]));
+    const afterClose = Number(psql(['-c', `select count(*) from public.seasonal_apply_audit where action='application_submitted' and id > ${closeAudit}`]));
+    const ok4 = r4.slice(1).filter(x => JSON.parse(x).ok).length;
+    console.log(`4) 手動締切と申込10件を同時: 締切後に保存 ${afterClose} 件 / 申込成功 ${ok4} 件（変更前 ${before} 件）`);
+    assert.equal(afterClose, 0);
+    // 締切前の版で計算した申込は「内容が変わった」として拒否される（締切の前に通った分のみ成功）
+    assert.ok(r4.slice(1).every(x => JSON.parse(x).ok || ['changed', 'closed', 'full'].includes(JSON.parse(x).issues[0].reason)));
+    console.log('同時実行テスト: すべて合格');
+  } finally {
+    try { psql(['-c', `drop database if exists ${DB} with (force)`], 'postgres'); } catch { /* cluster may be gone */ }
+    stopCluster();
+  }
+}
+
+main().catch(e => { console.error(e); process.exit(1); });
diff --git a/supabase/migrations/20261021090000_seasonal_apply_capacity.sql b/supabase/migrations/20261021090000_seasonal_apply_capacity.sql
new file mode 100644
index 0000000..410ac0d
--- /dev/null
+++ b/supabase/migrations/20261021090000_seasonal_apply_capacity.sql
@@ -0,0 +1,684 @@
+-- 2026 サンクスギビング・冬期講習: 保護者の申込（学年入力・きょうだい一括）と職員の定員・締切管理。
+--
+-- ■ 正本の分担
+--   講座名・日時・内容・持ち物・教材・担当・対象学年・集団/個別・換算数 = seasonal_plans.published_body
+--   （ポータルの季節講習時間割で編集。ここでは複製しない）
+--   定員・手動締切・料金倍率の確認値・教科表示 = seasonal_apply_course_controls（本ファイル）
+--   申込・お子さん・講座ごとの受講 = seasonal_apply_applications / _children / _items（本ファイル）
+--
+-- ■ 触らないもの
+--   通常講座・在籍・請求・既存の季節講習ログイン申込（seasonal_family_selections）・メール。
+--   seasonal_plans の行・ゲート（publication_enabled）も変更しない。読むだけ。
+--
+-- ■ 呼び出し経路
+--   全関数は service_role 専用（Next.js サーバーからのみ）。職員操作は p_actor を受け取り、
+--   DB の役割・個別権限で再確認する。保護者の申込は未ログインの公開フォームから届くため actor なし。
+--
+-- ■ 同時実行
+--   申込・定員変更・締切・取消はすべて最初に講習単位のトランザクションロック（seasonal_apply_lock）を取る。
+--   トランザクションの開始・確定は適用する側が行う（このファイルには begin/commit を書かない）。
+--   1講習の中で直列化するので、同時申込でも定員を超えない（申込は数百件規模で待ちは数ミリ秒）。
+
+create table public.seasonal_apply_settings (
+  plan_id uuid primary key references public.seasonal_plans(id),
+  campus_id uuid not null references public.campuses(id),
+  phase text not null default 'preparing' check (phase in ('preparing','open','closed')),
+  closes_at timestamptz,
+  next_receipt integer not null default 1 check (next_receipt > 0),
+  revision integer not null default 1 check (revision > 0),
+  updated_by uuid references public.users(id),
+  updated_at timestamptz not null default now()
+);
+
+create table public.seasonal_apply_course_controls (
+  plan_id uuid not null references public.seasonal_plans(id),
+  course_id uuid not null,
+  capacity integer check (capacity between 0 and 200),
+  manual_state text not null default 'open' check (manual_state in ('open','closed')),
+  price_multiplier numeric(4,2) check (price_multiplier > 0 and price_multiplier <= 10),
+  subject text check (char_length(subject) between 1 and 20),
+  revision integer not null default 1 check (revision > 0),
+  updated_by uuid not null references public.users(id),
+  updated_at timestamptz not null default now(),
+  primary key (plan_id, course_id)
+);
+
+create table public.seasonal_apply_applications (
+  id uuid primary key default gen_random_uuid(),
+  plan_id uuid not null references public.seasonal_plans(id),
+  campus_id uuid not null references public.campuses(id),
+  receipt_no text not null unique,
+  operation_id uuid not null unique,
+  request_hash text not null,
+  guardian_name text not null check (char_length(guardian_name) between 1 and 80),
+  email text not null check (char_length(email) between 3 and 200),
+  phone text not null check (char_length(phone) between 1 and 40),
+  affiliation text not null default '' check (char_length(affiliation) <= 40),
+  note text not null default '' check (char_length(note) <= 1000),
+  state text not null default 'active' check (state in ('active','cancelled')),
+  revision integer not null default 1 check (revision > 0),
+  published_revision integer not null,
+  pricing jsonb not null,
+  total numeric(12,2) not null check (total >= 0),
+  submitted_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  updated_by uuid references public.users(id),
+  cancel_reason text
+);
+create index seasonal_apply_applications_plan on public.seasonal_apply_applications(plan_id, submitted_at desc);
+create index seasonal_apply_applications_email on public.seasonal_apply_applications(plan_id, lower(email));
+
+create table public.seasonal_apply_children (
+  id uuid primary key default gen_random_uuid(),
+  application_id uuid not null references public.seasonal_apply_applications(id),
+  position integer not null check (position between 1 and 6),
+  name text not null check (char_length(name) between 1 and 60),
+  name_key text not null,
+  grade text not null check (grade in ('小1','小2','小3','小4','小5','小6','中1','中2','中3','高1','高2','高3')),
+  list_price numeric(12,2) not null default 0,
+  count_discount numeric(12,2) not null default 0,
+  tuition numeric(12,2) not null default 0,
+  sibling_rate numeric(4,2) not null default 0,
+  sibling_discount numeric(12,2) not null default 0,
+  amount numeric(12,2) not null default 0,
+  unique (application_id, position)
+);
+
+create table public.seasonal_apply_items (
+  id uuid primary key default gen_random_uuid(),
+  plan_id uuid not null references public.seasonal_plans(id),
+  application_id uuid not null references public.seasonal_apply_applications(id),
+  child_id uuid not null references public.seasonal_apply_children(id),
+  course_id uuid not null,
+  count_units integer not null check (count_units between 1 and 100),
+  price_multiplier numeric(4,2) not null check (price_multiplier > 0 and price_multiplier <= 10),
+  state text not null default 'active' check (state in ('active','cancelled')),
+  created_by uuid references public.users(id),
+  created_at timestamptz not null default now(),
+  cancelled_at timestamptz,
+  cancelled_by uuid references public.users(id),
+  cancel_reason text,
+  check ((state = 'active') = (cancelled_at is null))
+);
+create unique index seasonal_apply_items_one_active on public.seasonal_apply_items(child_id, course_id) where state = 'active';
+create index seasonal_apply_items_course on public.seasonal_apply_items(plan_id, course_id) where state = 'active';
+
+create table public.seasonal_apply_staff_operations (
+  actor_user_id uuid not null references public.users(id),
+  operation_id uuid not null,
+  plan_id uuid not null references public.seasonal_plans(id),
+  request_hash text not null,
+  result jsonb,
+  created_at timestamptz not null default now(),
+  primary key (actor_user_id, operation_id)
+);
+
+create table public.seasonal_apply_audit (
+  id bigint generated always as identity primary key,
+  plan_id uuid not null references public.seasonal_plans(id),
+  actor_user_id uuid references public.users(id),
+  action text not null,
+  target text not null,
+  detail jsonb not null,
+  occurred_at timestamptz not null default now()
+);
+
+alter table public.seasonal_apply_settings enable row level security;
+alter table public.seasonal_apply_course_controls enable row level security;
+alter table public.seasonal_apply_applications enable row level security;
+alter table public.seasonal_apply_children enable row level security;
+alter table public.seasonal_apply_items enable row level security;
+alter table public.seasonal_apply_staff_operations enable row level security;
+alter table public.seasonal_apply_audit enable row level security;
+revoke all on public.seasonal_apply_settings, public.seasonal_apply_course_controls, public.seasonal_apply_applications,
+  public.seasonal_apply_children, public.seasonal_apply_items, public.seasonal_apply_staff_operations, public.seasonal_apply_audit
+  from public, anon, authenticated, service_role;
+
+-- 監査は追記のみ。
+create function app_private.seasonal_apply_audit_append_only() returns trigger
+language plpgsql set search_path = '' as $$
+begin
+  raise exception '申込の操作履歴は変更・削除できません';
+end; $$;
+create trigger seasonal_apply_audit_append_only before update or delete on public.seasonal_apply_audit
+for each row execute function app_private.seasonal_apply_audit_append_only();
+
+-- ---------------------------------------------------------------------------------------------
+-- 共通
+-- ---------------------------------------------------------------------------------------------
+create function app_private.seasonal_apply_plan(p_campus uuid) returns public.seasonal_plans
+language sql stable set search_path = '' as $$
+  select * from public.seasonal_plans where campus_id = p_campus and cycle = '2026-thanksgiving-winter';
+$$;
+
+create function app_private.seasonal_apply_actor(p_actor uuid, p_campus uuid, p_permission text) returns uuid
+language plpgsql stable security definer set search_path = '' as $$
+begin
+  if p_actor is null
+     or not coalesce(app_private.staff_identity_email_matches(p_actor), false)
+     or not coalesce(app_private.actor_has_staff_permission(p_actor, p_permission, p_campus), false) then
+    raise exception '冬期講習の申込を管理する権限がありません';
+  end if;
+  return p_actor;
+end; $$;
+
+-- 申込・定員変更・締切・取消は必ずこれを最初に取る（同じ講習内で直列化し、ロック順を1つにする）。
+create function app_private.seasonal_apply_lock(p_plan uuid) returns void
+language sql set search_path = '' as $$
+  select pg_catalog.pg_advisory_xact_lock(pg_catalog.hashtextextended(p_plan::text || ':seasonal-apply-2026', 2026));
+$$;
+
+create function app_private.seasonal_apply_name_key(p text) returns text
+language sql immutable set search_path = '' as $$
+  select lower(regexp_replace(coalesce(p, ''), '[[:space:]　]', '', 'g'));
+$$;
+
+-- 公開済み（なければ下書き）の講座。保護者向けは公開済みのみを使う。
+create function app_private.seasonal_apply_course(p_body jsonb, p_course uuid) returns jsonb
+language sql immutable set search_path = '' as $$
+  select value from jsonb_array_elements(coalesce(p_body->'courses', '[]'::jsonb)) where value->>'id' = p_course::text limit 1;
+$$;
+
+create function app_private.seasonal_apply_counts(p_plan uuid) returns jsonb
+language sql stable set search_path = '' as $$
+  select coalesce(jsonb_object_agg(course_id::text, n), '{}'::jsonb)
+    from (select course_id, count(*) n from public.seasonal_apply_items
+           where plan_id = p_plan and state = 'active' group by course_id) x;
+$$;
+
+create function app_private.seasonal_apply_controls(p_plan uuid) returns jsonb
+language sql stable set search_path = '' as $$
+  select coalesce(jsonb_agg(jsonb_build_object('courseId', course_id, 'capacity', capacity, 'manualState', manual_state,
+    'priceMultiplier', price_multiplier, 'subject', subject, 'revision', revision, 'updatedAt', updated_at) order by course_id), '[]'::jsonb)
+    from public.seasonal_apply_course_controls where plan_id = p_plan;
+$$;
+
+create function app_private.seasonal_apply_settings_json(p_plan uuid) returns jsonb
+language sql stable set search_path = '' as $$
+  select coalesce((select jsonb_build_object('phase', phase, 'closesAt', closes_at, 'revision', revision, 'updatedAt', updated_at)
+                     from public.seasonal_apply_settings where plan_id = p_plan),
+                  jsonb_build_object('phase', 'preparing', 'closesAt', null, 'revision', 0, 'updatedAt', null));
+$$;
+
+create function app_private.seasonal_apply_teachers(p_campus uuid, p_body jsonb) returns jsonb
+language sql stable set search_path = '' as $$
+  select coalesce(jsonb_object_agg(t.id::text, t.name), '{}'::jsonb)
+    from public.teachers t
+   where t.campus_id = p_campus and t.is_active
+     and exists (select 1 from jsonb_array_elements(coalesce(p_body->'courses', '[]'::jsonb)) c where c->>'teacherId' = t.id::text);
+$$;
+
+create function app_private.seasonal_apply_public_body(p_body jsonb) returns jsonb
+language sql immutable set search_path = '' as $$
+  select jsonb_build_object('afternoonStart', p_body->'afternoonStart', 'courses',
+    coalesce((select jsonb_agg(jsonb_build_object('id', c->'id', 'termId', c->'termId', 'title', c->'title', 'content', c->'content',
+      'belongings', c->'belongings', 'materials', c->'materials', 'targetGrades', c->'targetGrades', 'teacherId', c->'teacherId',
+      'slotIds', c->'slotIds', 'billingUnits', c->'billingUnits', 'unitBasis', c->'unitBasis',
+      'instructionMode', coalesce(c->'instructionMode', 'null'::jsonb), 'status', c->'status'))
+      from jsonb_array_elements(coalesce(p_body->'courses', '[]'::jsonb)) c where c->>'status' <> 'cancelled'), '[]'::jsonb));
+$$;
+
+-- 申込明細（職員画面・取消再計算用）。
+create function app_private.seasonal_apply_application_json(p_app uuid) returns jsonb
+language sql stable set search_path = '' as $$
+  select jsonb_build_object('id', a.id, 'receiptNo', a.receipt_no, 'state', a.state, 'revision', a.revision,
+    'guardianName', a.guardian_name, 'email', a.email, 'phone', a.phone, 'affiliation', a.affiliation, 'note', a.note,
+    'total', a.total, 'pricing', a.pricing, 'submittedAt', a.submitted_at, 'updatedAt', a.updated_at, 'cancelReason', a.cancel_reason,
+    'children', (select coalesce(jsonb_agg(jsonb_build_object('id', ch.id, 'position', ch.position, 'name', ch.name, 'grade', ch.grade,
+        'listPrice', ch.list_price, 'countDiscount', ch.count_discount, 'tuition', ch.tuition, 'siblingRate', ch.sibling_rate,
+        'siblingDiscount', ch.sibling_discount, 'amount', ch.amount,
+        'items', (select coalesce(jsonb_agg(jsonb_build_object('id', i.id, 'courseId', i.course_id, 'countUnits', i.count_units,
+            'priceMultiplier', i.price_multiplier, 'state', i.state, 'createdAt', i.created_at, 'cancelledAt', i.cancelled_at,
+            'cancelReason', i.cancel_reason, 'byStaff', i.created_by is not null) order by i.created_at, i.id), '[]'::jsonb)
+          from public.seasonal_apply_items i where i.child_id = ch.id)) order by ch.position), '[]'::jsonb)
+      from public.seasonal_apply_children ch where ch.application_id = a.id))
+  from public.seasonal_apply_applications a where a.id = p_app;
+$$;
+
+-- サーバーで再計算した料金（pricing）を検証して子行へ反映する。金額は整数ドル・非負・合計一致。
+create function app_private.seasonal_apply_store_pricing(p_app uuid, p_pricing jsonb) returns numeric
+language plpgsql set search_path = '' as $$
+declare ch jsonb; total numeric := 0; n integer; pos integer;
+begin
+  if jsonb_typeof(p_pricing) is distinct from 'object' or jsonb_typeof(p_pricing->'children') is distinct from 'array' then
+    raise exception '料金の形式が不正です';
+  end if;
+  select count(*) into n from public.seasonal_apply_children where application_id = p_app;
+  if jsonb_array_length(p_pricing->'children') <> n then raise exception '料金とお子さんの人数が一致しません'; end if;
+  for ch in select value from jsonb_array_elements(p_pricing->'children') loop
+    pos := (ch->>'key')::integer;
+    if exists (select 1 from jsonb_each(ch) e where e.key in ('listPrice','countDiscount','tuition','siblingDiscount','amount')
+                 and (jsonb_typeof(e.value) <> 'number' or (e.value)::text::numeric < 0 or (e.value)::text::numeric <> trunc((e.value)::text::numeric)))
+       or (ch->>'amount')::numeric <> (ch->>'tuition')::numeric - (ch->>'siblingDiscount')::numeric
+       or (ch->>'countDiscount')::numeric <> (ch->>'listPrice')::numeric - (ch->>'tuition')::numeric then
+      raise exception '料金の内訳が一致しません';
+    end if;
+    update public.seasonal_apply_children set list_price = (ch->>'listPrice')::numeric, count_discount = (ch->>'countDiscount')::numeric,
+      tuition = (ch->>'tuition')::numeric, sibling_rate = coalesce((ch->>'siblingRate')::numeric, 0),
+      sibling_discount = (ch->>'siblingDiscount')::numeric, amount = (ch->>'amount')::numeric
+     where application_id = p_app and position = pos;
+    if not found then raise exception '料金のお子さんが一致しません'; end if;
+    total := total + (ch->>'amount')::numeric;
+  end loop;
+  if (p_pricing->>'total')::numeric is distinct from total then raise exception '料金の合計が一致しません'; end if;
+  return total;
+end; $$;
+
+create function app_private.seasonal_apply_staff_begin(p_actor uuid, p_op uuid, p_plan uuid, p_hash text) returns jsonb
+language plpgsql set search_path = '' as $$
+declare x public.seasonal_apply_staff_operations%rowtype;
+begin
+  if p_op is null then raise exception '操作IDが必要です'; end if;
+  insert into public.seasonal_apply_staff_operations(actor_user_id, operation_id, plan_id, request_hash)
+  values (p_actor, p_op, p_plan, p_hash) on conflict do nothing;
+  select * into x from public.seasonal_apply_staff_operations where actor_user_id = p_actor and operation_id = p_op for update;
+  if x.plan_id <> p_plan or x.request_hash <> p_hash then raise exception '同じ操作IDで内容の異なる操作が送られました'; end if;
+  return x.result;
+end; $$;
+
+create function app_private.seasonal_apply_staff_finish(p_actor uuid, p_op uuid, p_result jsonb) returns jsonb
+language sql set search_path = '' as $$
+  update public.seasonal_apply_staff_operations set result = p_result where actor_user_id = p_actor and operation_id = p_op returning p_result;
+$$;
+
+-- 申込可否を1講座ずつ判定する（ロック取得後に呼ぶ）。
+create function app_private.seasonal_apply_course_issue(p_plan public.seasonal_plans, p_course uuid, p_grade text, p_adding integer) returns jsonb
+language plpgsql stable set search_path = '' as $$
+declare c jsonb; ctl public.seasonal_apply_course_controls%rowtype; cap integer; used integer;
+begin
+  c := app_private.seasonal_apply_course(p_plan.published_body, p_course);
+  if c is null or c->>'status' <> 'ready' or coalesce(c->>'instructionMode', '') not in ('group','individual')
+     or c->>'billingUnits' is null or btrim(coalesce(c->>'unitBasis', '')) = '' then
+    return jsonb_build_object('courseId', p_course, 'reason', 'preparing', 'title', c->>'title');
+  end if;
+  if p_grade is not null and not (c->'targetGrades') ? p_grade then
+    return jsonb_build_object('courseId', p_course, 'reason', 'grade', 'title', c->>'title');
+  end if;
+  select * into ctl from public.seasonal_apply_course_controls where plan_id = p_plan.id and course_id = p_course;
+  if found and ctl.manual_state = 'closed' then
+    return jsonb_build_object('courseId', p_course, 'reason', 'closed', 'title', c->>'title');
+  end if;
+  cap := coalesce(ctl.capacity, case when c->>'instructionMode' = 'individual' then 3 else 12 end);
+  select count(*) into used from public.seasonal_apply_items where plan_id = p_plan.id and course_id = p_course and state = 'active';
+  if used + p_adding > cap then
+    return jsonb_build_object('courseId', p_course, 'reason', 'full', 'title', c->>'title', 'remaining', greatest(cap - used, 0));
+  end if;
+  return null;
+end; $$;
+
+-- ---------------------------------------------------------------------------------------------
+-- 保護者（公開フォーム）
+-- ---------------------------------------------------------------------------------------------
+create function public.portal_seasonal_apply_catalog(p_campus uuid) returns jsonb
+language plpgsql stable security definer set search_path = '' as $$
+declare plan public.seasonal_plans%rowtype;
+begin
+  plan := app_private.seasonal_apply_plan(p_campus);
+  if plan.id is null or not plan.publication_enabled or plan.published_body is null then
+    return jsonb_build_object('available', false);
+  end if;
+  return jsonb_build_object('available', true, 'planId', plan.id, 'publishedRevision', plan.published_revision,
+    'body', app_private.seasonal_apply_public_body(plan.published_body),
+    'teachers', app_private.seasonal_apply_teachers(p_campus, plan.published_body),
+    'settings', app_private.seasonal_apply_settings_json(plan.id),
+    'controls', app_private.seasonal_apply_controls(plan.id),
+    'counts', app_private.seasonal_apply_counts(plan.id),
+    'serverTime', now());
+end; $$;
+
+create function public.portal_seasonal_apply_submit(p_campus uuid, p_operation uuid, p_request jsonb) returns jsonb
+language plpgsql security definer set search_path = '' as $$
+declare
+  plan public.seasonal_plans%rowtype; st public.seasonal_apply_settings%rowtype; existing public.seasonal_apply_applications%rowtype;
+  hash text; g jsonb; ch jsonb; it jsonb; c jsonb; ctl public.seasonal_apply_course_controls%rowtype;
+  issues jsonb := '[]'::jsonb; issue jsonb; app_id uuid; v_child uuid; receipt text; v_total numeric;
+  adding jsonb := '{}'::jsonb; v_email text; child_count integer; item_count integer := 0; dup record; pos integer;
+begin
+  if p_operation is null or jsonb_typeof(p_request) is distinct from 'object' then raise exception '申込の形式が不正です'; end if;
+  -- 二重送信の判定は保護者の入力内容（intent）で行う。サーバー側の版番号が途中で変わっても同じ申込として扱う。
+  if jsonb_typeof(p_request->'intent') is distinct from 'object' then raise exception '申込の形式が不正です'; end if;
+  hash := md5((p_request->'intent')::text);
+  plan := app_private.seasonal_apply_plan(p_campus);
+  if plan.id is null or not plan.publication_enabled or plan.published_body is null then
+    return jsonb_build_object('ok', false, 'code', 'not_open');
+  end if;
+  perform app_private.seasonal_apply_lock(plan.id);
+  select * into st from public.seasonal_apply_settings where plan_id = plan.id for update;
+  -- 二重クリック・再送: 同じ操作IDはロック後に判定し、保存済みなら同じ結果を返す。
+  select * into existing from public.seasonal_apply_applications where operation_id = p_operation;
+  if found then
+    if existing.request_hash <> hash then return jsonb_build_object('ok', false, 'code', 'operation_conflict'); end if;
+    return jsonb_build_object('ok', true, 'replay', true, 'applicationId', existing.id, 'receiptNo', existing.receipt_no,
+      'submittedAt', existing.submitted_at, 'application', app_private.seasonal_apply_application_json(existing.id));
+  end if;
+  if st.plan_id is null or st.phase <> 'open' then return jsonb_build_object('ok', false, 'code', 'not_open'); end if;
+  if st.closes_at is not null and now() >= st.closes_at then return jsonb_build_object('ok', false, 'code', 'deadline'); end if;
+  if (p_request->>'publishedRevision')::integer is distinct from plan.published_revision then
+    return jsonb_build_object('ok', false, 'code', 'catalog_changed');
+  end if;
+
+  g := p_request->'guardian';
+  v_email := lower(btrim(coalesce(g->>'email', '')));
+  if jsonb_typeof(g) is distinct from 'object' or char_length(btrim(coalesce(g->>'name', ''))) not between 1 and 80
+     or v_email !~ '^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$' or char_length(v_email) > 200
+     or char_length(btrim(coalesce(g->>'phone', ''))) not between 1 and 40
+     or char_length(coalesce(g->>'affiliation', '')) > 40 or char_length(coalesce(g->>'note', '')) > 1000 then
+    raise exception '保護者の入力内容を確認してください';
+  end if;
+  if jsonb_typeof(p_request->'children') is distinct from 'array' then raise exception 'お子さんの入力を確認してください'; end if;
+  -- 1家庭（メールアドレス）1申込。講座数割引・きょうだい割引・日時の重複は申込の中で判定するため、
+  -- 追加・変更は職員が既存の申込を変更する（料金はまとめて再計算される）。
+  if exists (select 1 from public.seasonal_apply_applications a where a.plan_id = plan.id and a.state = 'active' and lower(a.email) = v_email) then
+    return jsonb_build_object('ok', false, 'code', 'family_exists');
+  end if;
+  child_count := jsonb_array_length(p_request->'children');
+  if child_count not between 1 and 6 then raise exception 'お子さんは1〜6人で入力してください'; end if;
+
+  -- 1講座ずつ: 公開・確定・対象学年・手動締切・料金設定の版・既申込・定員
+  for ch in select value from jsonb_array_elements(p_request->'children') loop
+    if char_length(btrim(coalesce(ch->>'name', ''))) not between 1 and 60 or jsonb_typeof(ch->'items') is distinct from 'array'
+       or jsonb_array_length(ch->'items') not between 1 and 30 then
+      raise exception 'お子さんのお名前と講座を確認してください';
+    end if;
+    for it in select value from jsonb_array_elements(ch->'items') loop
+      item_count := item_count + 1;
+      c := app_private.seasonal_apply_course(plan.published_body, (it->>'courseId')::uuid);
+      select * into ctl from public.seasonal_apply_course_controls where plan_id = plan.id and course_id = (it->>'courseId')::uuid;
+      if c is not null and (coalesce(ctl.revision, 0) <> coalesce((it->>'controlRevision')::integer, -1)
+          or (it->>'countUnits')::integer is distinct from (c->>'billingUnits')::integer
+          or (ctl.price_multiplier is not null and (it->>'priceMultiplier')::numeric is distinct from ctl.price_multiplier)) then
+        issues := issues || jsonb_build_array(jsonb_build_object('courseId', it->>'courseId', 'reason', 'changed', 'title', c->>'title', 'childPosition', ch->'position'));
+        continue;
+      end if;
+      adding := jsonb_set(adding, array[it->>'courseId'], to_jsonb(coalesce((adding->>(it->>'courseId'))::integer, 0) + 1));
+      issue := app_private.seasonal_apply_course_issue(plan, (it->>'courseId')::uuid, ch->>'grade', (adding->>(it->>'courseId'))::integer);
+      if issue is not null then
+        issues := issues || jsonb_build_array(issue || jsonb_build_object('childPosition', ch->'position'));
+        continue;
+      end if;
+      select a.receipt_no into dup from public.seasonal_apply_items i
+        join public.seasonal_apply_children x on x.id = i.child_id
+        join public.seasonal_apply_applications a on a.id = i.application_id
+       where i.plan_id = plan.id and i.course_id = (it->>'courseId')::uuid and i.state = 'active'
+         and lower(a.email) = v_email and x.name_key = app_private.seasonal_apply_name_key(ch->>'name') limit 1;
+      if found then
+        issues := issues || jsonb_build_array(jsonb_build_object('courseId', it->>'courseId', 'reason', 'already_applied',
+          'title', c->>'title', 'childPosition', ch->'position', 'receiptNo', dup.receipt_no));
+      end if;
+    end loop;
+  end loop;
+  if item_count > 60 then raise exception '一度に申し込める講座数を超えています'; end if;
+  if jsonb_array_length(issues) > 0 then
+    return jsonb_build_object('ok', false, 'code', 'unavailable', 'issues', issues,
+      'counts', app_private.seasonal_apply_counts(plan.id), 'controls', app_private.seasonal_apply_controls(plan.id));
+  end if;
+
+  receipt := 'MIW26-' || lpad(st.next_receipt::text, 4, '0');
+  update public.seasonal_apply_settings set next_receipt = next_receipt + 1 where plan_id = plan.id;
+  insert into public.seasonal_apply_applications(plan_id, campus_id, receipt_no, operation_id, request_hash, guardian_name, email, phone,
+    affiliation, note, published_revision, pricing, total)
+  values (plan.id, p_campus, receipt, p_operation, hash, btrim(g->>'name'), v_email, btrim(g->>'phone'),
+    coalesce(g->>'affiliation', ''), coalesce(g->>'note', ''), plan.published_revision, p_request->'pricing', 0)
+  returning id into app_id;
+  for ch in select value from jsonb_array_elements(p_request->'children') loop
+    pos := (ch->>'position')::integer;
+    insert into public.seasonal_apply_children(application_id, position, name, name_key, grade)
+    values (app_id, pos, btrim(ch->>'name'), app_private.seasonal_apply_name_key(ch->>'name'), ch->>'grade') returning id into v_child;
+    for it in select value from jsonb_array_elements(ch->'items') loop
+      insert into public.seasonal_apply_items(plan_id, application_id, child_id, course_id, count_units, price_multiplier)
+      values (plan.id, app_id, v_child, (it->>'courseId')::uuid, (it->>'countUnits')::integer, (it->>'priceMultiplier')::numeric);
+    end loop;
+  end loop;
+  v_total := app_private.seasonal_apply_store_pricing(app_id, p_request->'pricing');
+  if (p_request->>'total')::numeric is distinct from v_total then raise exception '支払合計が一致しません'; end if;
+  update public.seasonal_apply_applications set total = v_total where id = app_id;
+  insert into public.seasonal_apply_audit(plan_id, actor_user_id, action, target, detail)
+  values (plan.id, null, 'application_submitted', receipt, jsonb_build_object('applicationId', app_id, 'children', child_count, 'items', item_count, 'total', v_total));
+  return jsonb_build_object('ok', true, 'replay', false, 'applicationId', app_id, 'receiptNo', receipt,
+    'submittedAt', (select submitted_at from public.seasonal_apply_applications where id = app_id),
+    'application', app_private.seasonal_apply_application_json(app_id));
+end; $$;
+
+-- 再送の確認: 同じ操作IDの申込が保存済みなら、その結果を返す（事前確認より先に呼ぶ）。
+create function public.portal_seasonal_apply_replay(p_campus uuid, p_operation uuid, p_intent jsonb) returns jsonb
+language plpgsql stable security definer set search_path = '' as $$
+declare existing public.seasonal_apply_applications%rowtype;
+begin
+  select a.* into existing from public.seasonal_apply_applications a where a.operation_id = p_operation and a.campus_id = p_campus;
+  if not found then return null; end if;
+  if existing.request_hash <> md5(p_intent::text) then return jsonb_build_object('ok', false, 'code', 'operation_conflict'); end if;
+  return jsonb_build_object('ok', true, 'replay', true, 'applicationId', existing.id, 'receiptNo', existing.receipt_no,
+    'submittedAt', existing.submitted_at, 'application', app_private.seasonal_apply_application_json(existing.id));
+end; $$;
+
+-- ---------------------------------------------------------------------------------------------
+-- 職員
+-- ---------------------------------------------------------------------------------------------
+create function public.portal_seasonal_apply_admin_board(p_campus uuid, p_actor uuid) returns jsonb
+language plpgsql stable security definer set search_path = '' as $$
+declare plan public.seasonal_plans%rowtype; body jsonb; can_manage boolean;
+begin
+  perform app_private.seasonal_apply_actor(p_actor, p_campus, 'seasonal_applications.view');
+  can_manage := coalesce(app_private.actor_has_staff_permission(p_actor, 'seasonal_applications.manage', p_campus), false);
+  plan := app_private.seasonal_apply_plan(p_campus);
+  if plan.id is null then return jsonb_build_object('available', false, 'canManage', can_manage); end if;
+  body := coalesce(plan.published_body, plan.draft_body);
+  return jsonb_build_object('available', true, 'canManage', can_manage, 'planId', plan.id, 'planState', plan.state,
+    'publicationEnabled', plan.publication_enabled, 'publishedRevision', plan.published_revision,
+    'bodySource', case when plan.published_body is null then 'draft' else 'published' end,
+    'body', app_private.seasonal_apply_public_body(body),
+    'teachers', app_private.seasonal_apply_teachers(p_campus, body),
+    'settings', app_private.seasonal_apply_settings_json(plan.id),
+    'controls', app_private.seasonal_apply_controls(plan.id),
+    'counts', app_private.seasonal_apply_counts(plan.id),
+    'applications', (select coalesce(jsonb_agg(app_private.seasonal_apply_application_json(a.id) order by a.submitted_at desc), '[]'::jsonb)
+                       from public.seasonal_apply_applications a where a.plan_id = plan.id),
+    'audit', (select coalesce(jsonb_agg(x order by (x->>'id')::bigint desc), '[]'::jsonb) from (
+       select jsonb_build_object('id', au.id, 'action', au.action, 'target', au.target, 'detail', au.detail, 'occurredAt', au.occurred_at,
+         'actor', coalesce(u.display_name, case when au.actor_user_id is null then '保護者（申込フォーム）' else '職員' end)) x
+         from public.seasonal_apply_audit au left join public.users u on u.id = au.actor_user_id
+        where au.plan_id = plan.id order by au.id desc limit 300) y),
+    'serverTime', now());
+end; $$;
+
+create function public.portal_seasonal_apply_settings_update(p_campus uuid, p_actor uuid, p_operation uuid, p_expected_revision integer,
+  p_phase text, p_closes_at timestamptz, p_reason text) returns jsonb
+language plpgsql security definer set search_path = '' as $$
+declare plan public.seasonal_plans%rowtype; st public.seasonal_apply_settings%rowtype; replay jsonb; result jsonb; v_before jsonb;
+begin
+  perform app_private.seasonal_apply_actor(p_actor, p_campus, 'seasonal_applications.manage');
+  plan := app_private.seasonal_apply_plan(p_campus);
+  if plan.id is null then raise exception '季節講習が見つかりません'; end if;
+  if p_phase not in ('preparing','open','closed') then raise exception '受付状態が不正です'; end if;
+  if char_length(coalesce(p_reason, '')) > 300 then raise exception '理由は300文字以内で入力してください'; end if;
+  perform app_private.seasonal_apply_lock(plan.id);
+  replay := app_private.seasonal_apply_staff_begin(p_actor, p_operation, plan.id,
+    md5(jsonb_build_object('k','settings','r',p_expected_revision,'p',p_phase,'c',p_closes_at,'why',p_reason)::text));
+  if replay is not null then return replay; end if;
+  select * into st from public.seasonal_apply_settings where plan_id = plan.id for update;
+  if coalesce(st.revision, 0) is distinct from p_expected_revision then
+    raise exception '他の職員が受付設定を変更しました。画面を読み込み直してください';
+  end if;
+  if p_phase = 'open' and (not plan.publication_enabled or plan.published_body is null) then
+    raise exception '講座が保護者向けに公開されていないため、受付を開始できません';
+  end if;
+  v_before := jsonb_build_object('phase', coalesce(st.phase, 'preparing'), 'closesAt', st.closes_at);
+  insert into public.seasonal_apply_settings as x(plan_id, campus_id, phase, closes_at, revision, updated_by)
+  values (plan.id, p_campus, p_phase, p_closes_at, 1, p_actor)
+  on conflict (plan_id) do update set phase = excluded.phase, closes_at = excluded.closes_at, revision = x.revision + 1,
+    updated_by = excluded.updated_by, updated_at = now()
+  returning * into st;
+  insert into public.seasonal_apply_audit(plan_id, actor_user_id, action, target, detail)
+  values (plan.id, p_actor, 'settings_changed', '受付設定', jsonb_build_object('before', v_before,
+    'after', jsonb_build_object('phase', st.phase, 'closesAt', st.closes_at), 'reason', coalesce(p_reason, '')));
+  result := jsonb_build_object('ok', true, 'settings', app_private.seasonal_apply_settings_json(plan.id));
+  return app_private.seasonal_apply_staff_finish(p_actor, p_operation, result);
+end; $$;
+
+create function public.portal_seasonal_apply_course_update(p_campus uuid, p_actor uuid, p_operation uuid, p_course uuid,
+  p_expected_revision integer, p_patch jsonb) returns jsonb
+language plpgsql security definer set search_path = '' as $$
+declare plan public.seasonal_plans%rowtype; ctl public.seasonal_apply_course_controls%rowtype; c jsonb; replay jsonb; result jsonb;
+  v_before jsonb; v_after jsonb; used integer; k text; cap integer;
+begin
+  perform app_private.seasonal_apply_actor(p_actor, p_campus, 'seasonal_applications.manage');
+  plan := app_private.seasonal_apply_plan(p_campus);
+  if plan.id is null then raise exception '季節講習が見つかりません'; end if;
+  if jsonb_typeof(p_patch) is distinct from 'object' then raise exception '変更内容が不正です'; end if;
+  for k in select jsonb_object_keys(p_patch) loop
+    if k not in ('capacity','manualState','priceMultiplier','subject','reason') then raise exception '変更できない項目です: %', k; end if;
+  end loop;
+  -- 申込と同じ順序（設定行 → 講座行）でロックする。
+  perform app_private.seasonal_apply_lock(plan.id);
+  c := coalesce(app_private.seasonal_apply_course(plan.published_body, p_course), app_private.seasonal_apply_course(plan.draft_body, p_course));
+  if c is null then raise exception '講座が見つかりません'; end if;
+  replay := app_private.seasonal_apply_staff_begin(p_actor, p_operation, plan.id,
+    md5(jsonb_build_object('k','course','c',p_course,'r',p_expected_revision,'p',p_patch)::text));
+  if replay is not null then return replay; end if;
+  select * into ctl from public.seasonal_apply_course_controls where plan_id = plan.id and course_id = p_course for update;
+  if coalesce(ctl.revision, 0) <> p_expected_revision then
+    raise exception '他の職員がこの講座の設定を変更しました。画面を読み込み直してください';
+  end if;
+  v_before := jsonb_build_object('capacity', ctl.capacity, 'manualState', coalesce(ctl.manual_state, 'open'),
+    'priceMultiplier', ctl.price_multiplier, 'subject', ctl.subject);
+  if p_patch ? 'capacity' and p_patch->'capacity' <> 'null'::jsonb
+     and (jsonb_typeof(p_patch->'capacity') <> 'number' or (p_patch->>'capacity') !~ '^[0-9]{1,3}$' or (p_patch->>'capacity')::integer > 200) then
+    raise exception '定員は0〜200の整数で入力してください';
+  end if;
+  if p_patch ? 'manualState' and coalesce(p_patch->>'manualState', '') not in ('open','closed') then raise exception '受付状態が不正です'; end if;
+  if p_patch ? 'priceMultiplier' and p_patch->'priceMultiplier' <> 'null'::jsonb
+     and (jsonb_typeof(p_patch->'priceMultiplier') <> 'number' or (p_patch->>'priceMultiplier')::numeric <= 0
+          or (p_patch->>'priceMultiplier')::numeric > 10 or (p_patch->>'priceMultiplier')::numeric <> round((p_patch->>'priceMultiplier')::numeric, 2)) then
+    raise exception '料金倍率は0より大きく10以下、小数第2位までで入力してください';
+  end if;
+  if p_patch ? 'subject' and p_patch->'subject' <> 'null'::jsonb and char_length(coalesce(p_patch->>'subject', '')) not between 1 and 20 then
+    raise exception '教科の表示が不正です';
+  end if;
+  if char_length(coalesce(p_patch->>'reason', '')) > 300 then raise exception '理由は300文字以内で入力してください'; end if;
+  insert into public.seasonal_apply_course_controls as x(plan_id, course_id, capacity, manual_state, price_multiplier, subject, revision, updated_by)
+  values (plan.id, p_course,
+    case when p_patch ? 'capacity' then (p_patch->>'capacity')::integer else ctl.capacity end,
+    case when p_patch ? 'manualState' then p_patch->>'manualState' else coalesce(ctl.manual_state, 'open') end,
+    case when p_patch ? 'priceMultiplier' then (p_patch->>'priceMultiplier')::numeric else ctl.price_multiplier end,
+    case when p_patch ? 'subject' then nullif(p_patch->>'subject', '') else ctl.subject end,
+    1, p_actor)
+  on conflict (plan_id, course_id) do update set capacity = excluded.capacity, manual_state = excluded.manual_state,
+    price_multiplier = excluded.price_multiplier, subject = excluded.subject, revision = x.revision + 1,
+    updated_by = excluded.updated_by, updated_at = now()
+  returning * into ctl;
+  v_after := jsonb_build_object('capacity', ctl.capacity, 'manualState', ctl.manual_state, 'priceMultiplier', ctl.price_multiplier, 'subject', ctl.subject);
+  select count(*) into used from public.seasonal_apply_items where plan_id = plan.id and course_id = p_course and state = 'active';
+  cap := coalesce(ctl.capacity, case when c->>'instructionMode' = 'individual' then 3 else 12 end);
+  insert into public.seasonal_apply_audit(plan_id, actor_user_id, action, target, detail)
+  values (plan.id, p_actor, 'course_control_changed', coalesce(c->>'title', p_course::text),
+    jsonb_build_object('courseId', p_course, 'before', v_before, 'after', v_after, 'reason', coalesce(p_patch->>'reason', ''), 'applied', used));
+  result := jsonb_build_object('ok', true, 'revision', ctl.revision, 'applied', used, 'capacity', cap, 'overCapacity', used > cap);
+  return app_private.seasonal_apply_staff_finish(p_actor, p_operation, result);
+end; $$;
+
+-- 取消・追加（変更）。料金はサーバーで残りの講座から再計算した値を受け取り、内訳を検証して保存する。
+create function public.portal_seasonal_apply_modify(p_campus uuid, p_actor uuid, p_operation uuid, p_application uuid,
+  p_expected_revision integer, p_cancel_items uuid[], p_add jsonb, p_reason text, p_pricing jsonb) returns jsonb
+language plpgsql security definer set search_path = '' as $$
+declare plan public.seasonal_plans%rowtype; a public.seasonal_apply_applications%rowtype; replay jsonb; result jsonb;
+  it jsonb; issue jsonb; ch public.seasonal_apply_children%rowtype; v_total numeric; cancelled integer := 0; added integer := 0;
+  remaining integer; c jsonb; adding jsonb := '{}'::jsonb;
+begin
+  perform app_private.seasonal_apply_actor(p_actor, p_campus, 'seasonal_applications.manage');
+  plan := app_private.seasonal_apply_plan(p_campus);
+  if plan.id is null then raise exception '季節講習が見つかりません'; end if;
+  if char_length(btrim(coalesce(p_reason, ''))) not between 1 and 300 then raise exception '取消・変更の理由を入力してください'; end if;
+  if p_add is not null and jsonb_typeof(p_add) <> 'array' then raise exception '追加内容が不正です'; end if;
+  perform app_private.seasonal_apply_lock(plan.id);
+  replay := app_private.seasonal_apply_staff_begin(p_actor, p_operation, plan.id,
+    md5(jsonb_build_object('k','modify','a',p_application,'r',p_expected_revision,'c',p_cancel_items,'add',p_add,'why',p_reason,'p',p_pricing)::text));
+  if replay is not null then return replay; end if;
+  select * into a from public.seasonal_apply_applications where id = p_application and plan_id = plan.id for update;
+  if not found then raise exception '申込が見つかりません'; end if;
+  if a.revision <> p_expected_revision then raise exception '他の職員がこの申込を変更しました。画面を読み込み直してください'; end if;
+
+  if p_cancel_items is not null then
+    if exists (select 1 from unnest(p_cancel_items) x where not exists
+        (select 1 from public.seasonal_apply_items i where i.id = x and i.application_id = a.id and i.state = 'active')) then
+      raise exception '取消できない講座が含まれています';
+    end if;
+    update public.seasonal_apply_items set state = 'cancelled', cancelled_at = now(), cancelled_by = p_actor, cancel_reason = btrim(p_reason)
+     where application_id = a.id and id = any(p_cancel_items) and state = 'active';
+    get diagnostics cancelled = row_count;
+  end if;
+
+  for it in select value from jsonb_array_elements(coalesce(p_add, '[]'::jsonb)) loop
+    select * into ch from public.seasonal_apply_children where id = (it->>'childId')::uuid and application_id = a.id;
+    if not found then raise exception '追加先のお子さんが見つかりません'; end if;
+    c := app_private.seasonal_apply_course(plan.published_body, (it->>'courseId')::uuid);
+    if c is null or (it->>'countUnits')::integer is distinct from (c->>'billingUnits')::integer then
+      raise exception '講座または換算数が変わりました。画面を読み込み直してください';
+    end if;
+    if exists (select 1 from public.seasonal_apply_items where child_id = ch.id and course_id = (it->>'courseId')::uuid and state = 'active') then
+      raise exception '「%」は既に申込済みです', c->>'title';
+    end if;
+    adding := jsonb_set(adding, array[it->>'courseId'], to_jsonb(coalesce((adding->>(it->>'courseId'))::integer, 0) + 1));
+    -- 直前の追加分は既に行として入っているので、ここでは1席ぶんだけを確かめる。
+    issue := app_private.seasonal_apply_course_issue(plan, (it->>'courseId')::uuid, ch.grade, 1);
+    -- 職員の追加は手動締切中でも可能（定員・確定・対象学年は守る）。
+    if issue is not null and issue->>'reason' <> 'closed' then
+      raise exception '「%」を追加できません（%）', c->>'title',
+        case issue->>'reason' when 'full' then '満席' when 'grade' then '対象学年外' else '申込できる状態ではありません' end;
+    end if;
+    insert into public.seasonal_apply_items(plan_id, application_id, child_id, course_id, count_units, price_multiplier, created_by)
+    values (plan.id, a.id, ch.id, (it->>'courseId')::uuid, (it->>'countUnits')::integer, (it->>'priceMultiplier')::numeric, p_actor);
+    added := added + 1;
+  end loop;
+  if cancelled + added = 0 then raise exception '取消・追加する講座を選んでください'; end if;
+
+  v_total := app_private.seasonal_apply_store_pricing(a.id, p_pricing);
+  select count(*) into remaining from public.seasonal_apply_items where application_id = a.id and state = 'active';
+  update public.seasonal_apply_applications set pricing = p_pricing, total = v_total, revision = revision + 1, updated_at = now(), updated_by = p_actor,
+    state = case when remaining = 0 then 'cancelled' else 'active' end,
+    cancel_reason = case when remaining = 0 then btrim(p_reason) else null end
+   where id = a.id;
+  insert into public.seasonal_apply_audit(plan_id, actor_user_id, action, target, detail)
+  values (plan.id, p_actor, case when remaining = 0 then 'application_cancelled' else 'application_changed' end, a.receipt_no,
+    jsonb_build_object('applicationId', a.id, 'cancelledItems', cancelled, 'addedItems', added, 'totalBefore', a.total, 'totalAfter', v_total, 'reason', btrim(p_reason)));
+  result := jsonb_build_object('ok', true, 'application', app_private.seasonal_apply_application_json(a.id));
+  return app_private.seasonal_apply_staff_finish(p_actor, p_operation, result);
+end; $$;
+
+revoke all on function
+  app_private.seasonal_apply_audit_append_only(), app_private.seasonal_apply_plan(uuid), app_private.seasonal_apply_lock(uuid), app_private.seasonal_apply_actor(uuid,uuid,text),
+  app_private.seasonal_apply_name_key(text), app_private.seasonal_apply_course(jsonb,uuid), app_private.seasonal_apply_counts(uuid),
+  app_private.seasonal_apply_controls(uuid), app_private.seasonal_apply_settings_json(uuid), app_private.seasonal_apply_teachers(uuid,jsonb),
+  app_private.seasonal_apply_public_body(jsonb), app_private.seasonal_apply_application_json(uuid), app_private.seasonal_apply_store_pricing(uuid,jsonb),
+  app_private.seasonal_apply_staff_begin(uuid,uuid,uuid,text), app_private.seasonal_apply_staff_finish(uuid,uuid,jsonb),
+  app_private.seasonal_apply_course_issue(public.seasonal_plans,uuid,text,integer),
+  public.portal_seasonal_apply_catalog(uuid), public.portal_seasonal_apply_submit(uuid,uuid,jsonb), public.portal_seasonal_apply_replay(uuid,uuid,jsonb),
+  public.portal_seasonal_apply_admin_board(uuid,uuid),
+  public.portal_seasonal_apply_settings_update(uuid,uuid,uuid,integer,text,timestamptz,text),
+  public.portal_seasonal_apply_course_update(uuid,uuid,uuid,uuid,integer,jsonb),
+  public.portal_seasonal_apply_modify(uuid,uuid,uuid,uuid,integer,uuid[],jsonb,text,jsonb)
+  from public, anon, authenticated, service_role;
+grant execute on function
+  public.portal_seasonal_apply_catalog(uuid), public.portal_seasonal_apply_submit(uuid,uuid,jsonb), public.portal_seasonal_apply_replay(uuid,uuid,jsonb),
+  public.portal_seasonal_apply_admin_board(uuid,uuid),
+  public.portal_seasonal_apply_settings_update(uuid,uuid,uuid,integer,text,timestamptz,text),
+  public.portal_seasonal_apply_course_update(uuid,uuid,uuid,uuid,integer,jsonb),
+  public.portal_seasonal_apply_modify(uuid,uuid,uuid,uuid,integer,uuid[],jsonb,text,jsonb)
+  to service_role;
+
+-- ---------------------------------------------------------------------------------------------
+-- 権限: 申込の閲覧／定員・締切・取消の管理。校長ロールにのみ付け、他の職員へは校長が個別に付与する。
+-- ---------------------------------------------------------------------------------------------
+do $$
+declare v_principal uuid; v_perm uuid; v_code text;
+begin
+  insert into public.permissions(code, name, description) values
+    ('seasonal_applications.view', '季節講習の申込を閲覧', '冬期講習の申込一覧・残席・受付状態・操作履歴を確認します。'),
+    ('seasonal_applications.manage', '季節講習の定員・締切を管理', '講座ごとの定員・受付締切・受付再開・料金倍率の確認値、受付期間、申込の取消・変更を行います。')
+  on conflict (code) do update set name = excluded.name, description = excluded.description;
+  select id into v_principal from public.roles where code = 'principal';
+  if v_principal is null then raise exception '校長ロールが見つかりません'; end if;
+  foreach v_code in array array['seasonal_applications.view','seasonal_applications.manage'] loop
+    select id into v_perm from public.permissions where code = v_code;
+    insert into public.role_permissions(role_id, permission_id) values (v_principal, v_perm) on conflict do nothing;
+  end loop;
+end $$;
