+    const r = await submitApplication(rpc2, campus, randomUUID(), { guardian, children: [{ name: '太郎', grade: '小5', courseIds: [KEISAN_W1] }] }, NOW);
+    assert.equal(r.ok, false);
+    assert.equal(!r.ok && r.code, 'not_open');
