@@ -0,0 +1,534 @@
+'use client';
+// 2026 サンクスギビング・冬期講習 保護者申込（公開フォーム）。
+// 料金表示はサーバーと同じ関数で計算するが、保存する金額は送信時にサーバーが再計算する。
+import { useEffect, useMemo, useRef, useState } from 'react';
+import type { ReactNode } from 'react';
+import s from './winter.module.css';
+import {
+  COURSE_KIND_LABEL, PUBLIC_STATUS_LABEL, SUBJECTS, TERMS, coursesOverlap, formatDate, formatTime, gradeRangeLabel,
+  type CourseKind, type PublicCourse, type Session,
+} from '@/lib/seasonal-apply-catalog';
+import { GRADE_BAND_LABEL, formatUsd, gradeBand, tierPrice, type Grade, type GradeBand } from '@/lib/seasonal-apply-pricing';
+import { priceSelection, type ApplyInput, type PublicCatalog, type SubmitResult } from '@/lib/seasonal-apply-service';
+
+export type WinterApplyActions = {
+  refresh: () => Promise<PublicCatalog>;
+  submit: (operationId: string, input: ApplyInput) => Promise<SubmitResult>;
+};
+
+type Child = { uid: string; name: string; grade: Grade | ''; courseIds: string[] };
+type Guardian = ApplyInput['guardian'] & { emailConfirm: string };
+type Step = 1 | 2 | 3 | 4;
+
+const uid = () => (globalThis.crypto?.randomUUID ? globalThis.crypto.randomUUID() : `${Date.now()}-${Math.random().toString(16).slice(2)}`);
+const opId = () => (globalThis.crypto?.randomUUID ? globalThis.crypto.randomUUID()
+  : 'xxxxxxxx-xxxx-4xxx-8xxx-xxxxxxxxxxxx'.replace(/x/g, () => Math.floor(Math.random() * 16).toString(16)));
+
+const BAND_GRADES: Record<GradeBand, Grade[]> = {
+  elementary: ['小1', '小2', '小3', '小4', '小5', '小6'],
+  middle: ['中1', '中2', '中3'],
+  high: ['高1', '高2', '高3'],
+};
+
+function sessionText(list: Session[]): string {
+  if (list.length === 0) return '';
+  const sameTime = list.every(x => x.start === list[0].start && x.end === list[0].end);
+  if (sameTime) {
+    const dates = list.length > 1 ? `${formatDate(list[0].date)}〜${formatDate(list[list.length - 1].date)}（全${list.length}回）` : formatDate(list[0].date);
+    return `${dates} ${formatTime(list[0].start)}〜${formatTime(list[0].end)}`;
+  }
+  return list.map(x => `${formatDate(x.date)} ${formatTime(x.start)}〜${formatTime(x.end)}`).join(' / ');
+}
+
+function listPriceFor(c: PublicCourse, grade: Grade): number | null {
+  if (c.countUnits == null || c.priceMultiplier == null) return null;
+  return Math.round(tierPrice(gradeBand(grade), 1) * c.countUnits * c.priceMultiplier);
+}
+
+const childLabel = (c: Child, i: number) => (c.name.trim() ? `${c.name.trim()}さん` : `${i + 1}人目のお子さん`);
+
+export default function WinterApply({ initial, actions, logoSrc, crestSrc, banner }: {
+  initial: PublicCatalog; actions: WinterApplyActions; logoSrc: string; crestSrc: string; banner?: ReactNode;
+}) {
+  const [catalog, setCatalog] = useState(initial);
+  const [step, setStep] = useState<Step>(1);
+  const [children, setChildren] = useState<Child[]>([{ uid: uid(), name: '', grade: '', courseIds: [] }]);
+  const [active, setActive] = useState(0);
+  const [guardian, setGuardian] = useState<Guardian>({ name: '', email: '', emailConfirm: '', phone: '', affiliation: '', note: '' });
+  const [errors, setErrors] = useState<string[]>([]);
+  const [invalid, setInvalid] = useState<string[]>([]);
+  const [notice, setNotice] = useState<string[]>([]);
+  const [busy, setBusy] = useState(false);
+  const [result, setResult] = useState<Extract<SubmitResult, { ok: true }> | null>(null);
+  const [sheetOpen, setSheetOpen] = useState(false);
+  const [website, setWebsite] = useState('');
+  const operation = useRef<{ id: string; key: string } | null>(null);
+  const topRef = useRef<HTMLDivElement>(null);
+
+  const byId = useMemo(() => new Map(catalog.courses.map(c => [c.id, c])), [catalog]);
+  const pricing = useMemo(() => {
+    try {
+      const priced = children.filter(c => c.grade && c.courseIds.length);
+      return { ok: true as const, value: priceSelection(byId, priced.map(c => ({ name: c.name, grade: c.grade, courseIds: c.courseIds }))), priced };
+    } catch {
+      return { ok: false as const, value: null, priced: [] as Child[] };
+    }
+  }, [children, byId]);
+
+  useEffect(() => { topRef.current?.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, [step]);
+
+  const update = (i: number, patch: Partial<Child>) => setChildren(prev => prev.map((c, j) => (j === i ? { ...c, ...patch } : c)));
+
+  const bandCounts = useMemo(() => {
+    const out: Record<GradeBand, number> = { elementary: 0, middle: 0, high: 0 };
+    for (const c of catalog.courses) for (const b of c.bands) out[b]++;
+    return out;
+  }, [catalog]);
+
+  if (!catalog.available) {
+    return (
+      <Shell logoSrc={logoSrc} crestSrc={crestSrc} banner={banner} topRef={topRef}>
+        <div className={s.card}><h2>お申し込みは準備中です</h2><p className={s.lead}>講座の公開まで、いましばらくお待ちください。</p></div>
+      </Shell>
+    );
+  }
+
+  function goStep2() {
+    const missing = children.map((c, i) => (c.grade ? null : i)).filter((x): x is number => x != null);
+    if (missing.length) {
+      setInvalid(missing.map(i => `grade-${i}`));
+      setErrors([`${childLabel(children[missing[0]], missing[0])}の学年を選んでください。`]);
+      return;
+    }
+    setErrors([]); setInvalid([]);
+    // 学年を変えた場合、その学年で受講できない講座は選択から外す
+    setChildren(prev => prev.map(c => ({ ...c, courseIds: c.courseIds.filter(id => byId.get(id)?.targetGrades.includes(c.grade as Grade)) })));
+    setStep(2);
+  }
+
+  async function goStep3() {
+    const empty = children.findIndex(c => c.courseIds.length === 0);
+    if (empty >= 0) { setActive(empty); setErrors([`${childLabel(children[empty], empty)}の講座を1つ以上選んでください。`]); return; }
+    setErrors([]);
+    setBusy(true);
+    let next = children;
+    try { next = applyFresh(await actions.refresh()).children; } catch { /* 表示中の内容で続け、送信時に再確認する */ }
+    finally { setBusy(false); }
+    // 最新の状態で講座が1つも残らないお子さんがいれば、講座の選択にとどまる
+    const emptyAfter = next.findIndex(c => c.courseIds.length === 0);
+    if (emptyAfter >= 0) { setActive(emptyAfter); return; }
+    setStep(3);
+  }
+
+  /** 最新の受付状態を取り込み、申し込めなくなった講座は選択から外して知らせる。 */
+  function applyFresh(fresh: PublicCatalog): { removed: string[]; children: Child[] } {
+    setCatalog(fresh);
+    const map = new Map(fresh.courses.map(c => [c.id, c]));
+    const removed: string[] = [];
+    // 同じ講座を複数のお子さんが選んでいる場合は、残席の数まで先に選んだお子さんを残す
+    const seats = new Map(fresh.courses.map(c => [c.id, c.status === 'open' ? c.remaining : 0]));
+    const next = children.map((c, i) => {
+      const keep = c.courseIds.filter(id => {
+        const v = map.get(id);
+        const left = seats.get(id) ?? 0;
+        const ok = !!v && v.status === 'open' && left > 0;
+        if (ok) seats.set(id, left - 1);
+        else removed.push(`${childLabel(c, i)}: 「${v?.title ?? byId.get(id)?.title ?? '講座'}」は${v && v.status !== 'open' ? PUBLIC_STATUS_LABEL[v.status] : v ? '満席' : '公開が終了'}のため、選択から外しました。`);
+        return ok;
+      });
+      return { ...c, courseIds: keep };
+    });
+    setChildren(next);
+    if (removed.length) setNotice(removed);
+    return { removed, children: next };
+  }
+
+  function validateGuardian(): string[] {
