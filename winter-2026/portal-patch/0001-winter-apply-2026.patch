+'use server';
+// 冬期講習 保護者申込の Server Action。未ログインの公開フォームから呼ばれる。
+// 金額・定員・受付状態はすべてサーバーで判定する（ブラウザの値は使わない）。
+import { seasonalApplyBackend } from '@/lib/seasonal-apply-server';
+import { loadPublicCatalog, submitApplication, type ApplyInput, type PublicCatalog, type SubmitResult } from '@/lib/seasonal-apply-service';
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+export async function refreshWinterCatalog(): Promise<PublicCatalog> {
+  const b = await seasonalApplyBackend();
+  return loadPublicCatalog(b.rpc, b.campusId);
+}
+
+export async function submitWinterApplication(operationId: string, input: ApplyInput): Promise<SubmitResult> {
+  if (typeof operationId !== 'string' || !UUID.test(operationId)) {
+    return { ok: false, code: 'invalid', message: '画面を読み込み直してから、もう一度お申し込みください。', issues: [] };
+  }
+  try {
+    const b = await seasonalApplyBackend();
+    return await submitApplication(b.rpc, b.campusId, operationId.toLowerCase(), input);
+  } catch (e) {
+    console.error('[winter-apply] submit failed', e instanceof Error ? e.message : e);
+    return { ok: false, code: 'error', message: '送信できませんでした。時間をおいて、もう一度「申し込む」を押してください（同じ内容は二重に登録されません）。', issues: [] };
+  }
+}
