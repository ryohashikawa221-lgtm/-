diff --git a/lib/seasonal-apply-catalog.ts b/lib/seasonal-apply-catalog.ts
new file mode 100644
index 0000000..e74ca4e
--- /dev/null
+++ b/lib/seasonal-apply-catalog.ts
@@ -0,0 +1,318 @@
+/**
+ * 冬期講習申込: ポータルの季節講習データ（seasonal_plans.published_body）から
+ * 保護者に見せる講座情報を作る純粋関数群。講座名・日時・内容・持ち物・教材・担当は
+ * ポータルの時間割で編集した値をそのまま使い、ここでは複製・上書きしない。
+ * 申込側で持つのは「定員・手動締切・料金倍率の確認値・教科の表示分類」だけ。
+ */
+import { GRADES, gradeBand, isGrade, type Grade, type GradeBand } from './seasonal-apply-pricing';
+
+export const DEFAULT_CAPACITY = { group: 12, individual: 3 } as const;
+
+export const TERMS = [
+  { id: 'thanksgiving', label: 'サンクスギビング講習', short: 'サンクスギビング' },
+  { id: 'winter1', label: '冬期講習 1ターム', short: '冬期1' },
+  { id: 'winter2', label: '冬期講習 2ターム', short: '冬期2' },
+  { id: 'winter3', label: '冬期講習 3ターム', short: '冬期3' },
+] as const;
+export type TermId = typeof TERMS[number]['id'];
+
+export const SUBJECTS = ['算数・数学', '国語', '英語', '理科', 'テスト対策', '探究・進路', '文化・工作', '個別指導', 'その他'] as const;
+export type Subject = typeof SUBJECTS[number];
+
+export type CourseKind = 'group' | 'individual' | 'double';
+export const COURSE_KIND_LABEL: Record<CourseKind, string> = {
+  group: '集団',
+  individual: '個別',
+  double: '2コマ連続',
+};
+
+export type PortalCourse = {
+  id: string;
+  termId: string;
+  title: string;
+  content: string;
+  belongings: string;
+  materials: string;
+  targetGrades: string[];
+  teacherLabel?: string;
+  teacherId: string | null;
+  slotIds: string[];
+  billingUnits: number | null;
+  unitBasis: string;
+  instructionMode?: 'group' | 'individual' | null;
+  status: 'draft' | 'ready' | 'cancelled';
+};
+
+export type PortalPlanBody = { courses: PortalCourse[]; afternoonStart?: string };
+
+export type CourseControl = {
+  courseId: string;
+  capacity: number | null;
+  manualState: 'open' | 'closed';
+  priceMultiplier: number | null;
+  subject: string | null;
+  revision: number;
+};
+
+export type PlanPhase = 'preparing' | 'open' | 'closed';
+
+export type ApplySettings = {
+  phase: PlanPhase;
+  closesAt: string | null;
+  revision: number;
+};
+
+export type Session = { date: string; start: string; end: string };
+
+export type PublicStatus = 'open' | 'full' | 'closed' | 'preparing';
+export const PUBLIC_STATUS_LABEL: Record<PublicStatus, string> = {
+  open: '受付中',
+  full: '満席',
+  closed: '締切',
+  preparing: '準備中',
+};
+
+export type CourseView = {
+  id: string;
+  termId: TermId;
+  termLabel: string;
+  title: string;
+  content: string;
+  belongings: string;
+  materials: string;
+  teacher: string;
+  targetGrades: Grade[];
+  bands: GradeBand[];
+  sessions: Session[];
+  kind: CourseKind | null;
+  subject: Subject;
+  /** 料金計算に使う値。null は未確定（申込不可）。 */
+  countUnits: number | null;
+  priceMultiplier: number | null;
+  multiplierSource: 'auto' | 'manual' | null;
+  capacity: number;
+  capacitySource: 'default' | 'manual';
+  applied: number;
+  remaining: number;
+  manualState: 'open' | 'closed';
+  status: PublicStatus;
+  /** 職員向け: 申込不可・要確認の理由。保護者画面には出さない。 */
+  issues: string[];
+  shape: 'standard' | 'double' | 'nonstandard';
+  controlRevision: number;
+};
+
+const LEGACY_STARTS = ['09:00', '10:30', '12:30', '14:00', '15:30'];
+const LEGACY_ENDS = ['10:30', '12:00', '14:00', '15:30', '17:00'];
+
+export function parseSlot(id: string): Session | null {
+  let m = /^(\d{4}-\d{2}-\d{2})@(\d{2}:\d{2})-(\d{2}:\d{2})$/.exec(id);
+  if (m) return { date: m[1], start: m[2], end: m[3] };
+  m = /^(\d{4}-\d{2}-\d{2}):([0-4])$/.exec(id);
+  if (m) return { date: m[1], start: LEGACY_STARTS[+m[2]], end: LEGACY_ENDS[+m[2]] };
+  return null;
+}
+
+export function minutes(t: string): number {
+  const [h, m] = t.split(':').map(Number);
+  return h * 60 + m;
+}
+
+export function sessionsOverlap(a: Session, b: Session): boolean {
+  return a.date === b.date && minutes(a.start) < minutes(b.end) && minutes(b.start) < minutes(a.end);
+}
+
+export function coursesOverlap(a: { sessions: Session[] }, b: { sessions: Session[] }): boolean {
+  return a.sessions.some(x => b.sessions.some(y => sessionsOverlap(x, y)));
+}
+
+export function courseShape(sessions: Session[]): CourseView['shape'] {
+  if (sessions.length !== 3) return 'nonstandard';
+  const lens = sessions.map(s => minutes(s.end) - minutes(s.start));
+  if (lens.every(l => l === 90)) return 'standard';
+  if (lens.every(l => l === 180)) return 'double';
+  return 'nonstandard';
+}
+
+/** 指導形態と時間・回数から自動で決まる料金倍率。決まらない形は null（職員の確認待ち）。 */
+export function autoMultiplier(mode: 'group' | 'individual' | null | undefined, shape: CourseView['shape']): number | null {
+  if (mode === 'group' && shape === 'standard') return 1;
+  if (mode === 'individual' && shape === 'standard') return 1.4;
+  if (mode === 'group' && shape === 'double') return 1.6;
+  return null;
+}
+
+const SUBJECT_RULES: Array<[RegExp, Subject]> = [
+  [/個別/, '個別指導'],
+  [/マンスリー|テスト対策/, 'テスト対策'],
+  [/志望校|探求|探究|小論文|進路/, '探究・進路'],
+  [/算数|数学|計算|数[IⅠ1ⅡIIBC]/, '算数・数学'],
+  [/理科|化学|物理|生物|地学/, '理科'],
+  [/英語|英検|TOEFL|SAT|English/i, '英語'],
+  [/国語|古文|漢文|作文|さくぶん|説明文|読解|文法|百人一首|知識事項/, '国語'],
+  [/工作|カード|版画|年賀状|コースター|オーナメント|絵本|えほん|鏡餅|カリグラフィー|習字|スタンプ|ハンコ/, '文化・工作'],
+];
+
+export function guessSubject(title: string): Subject {
+  for (const [re, s] of SUBJECT_RULES) if (re.test(title)) return s;
+  return 'その他';
+}
+
+export function isSubject(v: unknown): v is Subject {
+  return typeof v === 'string' && (SUBJECTS as readonly string[]).includes(v);
+}
+
+export function termLabel(termId: string): string {
+  return TERMS.find(t => t.id === termId)?.label ?? termId;
+}
+
+export function planAccepting(settings: ApplySettings, now: Date): boolean {
+  if (settings.phase !== 'open') return false;
+  if (settings.closesAt && now.getTime() >= new Date(settings.closesAt).getTime()) return false;
+  return true;
+}
+
+export function planPhaseNow(settings: ApplySettings, now: Date): PlanPhase {
+  if (settings.phase === 'open' && !planAccepting(settings, now)) return 'closed';
+  return settings.phase;
+}
+
+export type BuildCatalogInput = {
+  body: PortalPlanBody | null;
+  teachers: Record<string, string>;
+  controls: CourseControl[];
+  counts: Record<string, number>;
+  settings: ApplySettings;
+  now: Date;
+};
+
+export function buildCatalog(input: BuildCatalogInput): CourseView[] {
+  const controls = new Map(input.controls.map(c => [c.courseId, c]));
+  const phase = planPhaseNow(input.settings, input.now);
+  const views: CourseView[] = [];
+  for (const c of input.body?.courses ?? []) {
+    if (c.status === 'cancelled') continue;
+    if (!TERMS.some(t => t.id === c.termId)) continue;
+    const sessions = c.slotIds.map(parseSlot).filter((s): s is Session => !!s)
+      .sort((a, b) => (a.date + a.start).localeCompare(b.date + b.start));
+    const grades = GRADES.filter(g => c.targetGrades.includes(g));
+    const control = controls.get(c.id);
+    const shape = courseShape(sessions);
+    const mode = c.instructionMode ?? null;
+    const kind: CourseKind | null = mode === 'individual' ? 'individual' : mode === 'group' ? (shape === 'double' ? 'double' : 'group') : null;
+    const auto = autoMultiplier(mode, shape);
+    const manualMultiplier = control?.priceMultiplier ?? null;
+    const priceMultiplier = manualMultiplier ?? auto;
+    const capacity = control?.capacity ?? (mode === 'individual' ? DEFAULT_CAPACITY.individual : DEFAULT_CAPACITY.group);
+    const applied = input.counts[c.id] ?? 0;
+    const remaining = Math.max(0, capacity - applied);
+    const manualState = control?.manualState ?? 'open';
+    const countUnits = typeof c.billingUnits === 'number' && Number.isInteger(c.billingUnits) && c.billingUnits > 0 ? c.billingUnits : null;
+
+    const issues: string[] = [];
+    if (c.status !== 'ready') issues.push('ポータルで講座が「確定」になっていません');
+    if (!mode) issues.push('集団・個別が未設定です（ポータルで設定）');
+    if (countUnits == null || !c.unitBasis.trim()) issues.push('講座数割引の換算数・根拠が未確定です（ポータルで設定）');
+    if (priceMultiplier == null) issues.push(shape === 'nonstandard'
+      ? `時間・回数が標準と異なります（${sessions.length}回）。料金倍率を確認して入力してください`
+      : '料金倍率を確認して入力してください');
+    if (!c.teacherId || !input.teachers[c.teacherId]) issues.push('担当講師が未設定です');
+    if (sessions.length === 0) issues.push('日時が未設定です');
+    if (grades.length === 0) issues.push('対象学年が未設定です');
+
+    let status: PublicStatus;
+    if (issues.length > 0 || phase === 'preparing') status = 'preparing';
+    else if (phase === 'closed' || manualState === 'closed') status = 'closed';
+    else if (remaining <= 0) status = 'full';
+    else status = 'open';
+
+    const subjectOverride = control?.subject;
+    views.push({
+      id: c.id,
+      termId: c.termId as TermId,
+      termLabel: termLabel(c.termId),
+      title: c.title,
+      content: c.content,
+      belongings: c.belongings,
+      materials: c.materials,
+      teacher: c.teacherId && input.teachers[c.teacherId] ? `${input.teachers[c.teacherId]}先生` : '',
+      targetGrades: grades,
+      bands: [...new Set(grades.map(gradeBand))],
+      sessions,
+      kind,
+      subject: isSubject(subjectOverride) ? subjectOverride : guessSubject(c.title),
+      countUnits,
+      priceMultiplier,
+      multiplierSource: manualMultiplier != null ? 'manual' : auto != null ? 'auto' : null,
+      capacity,
+      capacitySource: control?.capacity != null ? 'manual' : 'default',
+      applied,
+      remaining,
+      manualState,
+      status,
+      issues,
+      shape,
+      controlRevision: control?.revision ?? 0,
+    });
+  }
+  return views.sort((a, b) => {
+    const ta = TERMS.findIndex(t => t.id === a.termId), tb = TERMS.findIndex(t => t.id === b.termId);
+    if (ta !== tb) return ta - tb;
+    const sa = a.sessions[0], sb = b.sessions[0];
+    return ((sa?.date ?? '') + (sa?.start ?? '')).localeCompare((sb?.date ?? '') + (sb?.start ?? '')) || a.title.localeCompare(b.title, 'ja');
+  });
+}
+
+/** 保護者に返す講座情報（職員向けの理由・定員の内訳は含めない）。 */
+export type PublicCourse = Omit<CourseView, 'issues' | 'capacitySource' | 'multiplierSource' | 'manualState' | 'controlRevision' | 'applied' | 'capacity'>;
+
+export function toPublicCourse(v: CourseView): PublicCourse {
+  // eslint-disable-next-line @typescript-eslint/no-unused-vars
+  const { issues, capacitySource, multiplierSource, manualState, controlRevision, applied, capacity, ...rest } = v;
+  return { ...rest, remaining: v.status === 'preparing' ? 0 : rest.remaining };
+}
+
+export function gradeRangeLabel(grades: readonly Grade[]): string {
+  if (grades.length === 0) return '';
+  const idx = grades.map(g => GRADES.indexOf(g)).sort((a, b) => a - b);
+  const contiguous = idx.every((v, i) => i === 0 || v === idx[i - 1] + 1);
+  if (contiguous && idx.length > 1) return `${GRADES[idx[0]]}〜${GRADES[idx[idx.length - 1]]}`;
+  return idx.map(i => GRADES[i]).join('・');
+}
+
+export function formatDate(date: string): string {
+  const d = new Date(`${date}T12:00:00Z`);
+  const wd = ['日', '月', '火', '水', '木', '金', '土'][d.getUTCDay()];
+  return `${d.getUTCMonth() + 1}/${d.getUTCDate()}(${wd})`;
+}
+
+/** 09:00 → 9:00（保護者向けの表記） */
+export function formatTime(t: string): string {
+  return t.replace(/^0(\d)/, '$1');
+}
+
+export type ChildSelectionCheck =
+  | { ok: true }
+  | { ok: false; code: 'grade' | 'status' | 'overlap' | 'unknown' | 'duplicate'; courseId: string; otherCourseId?: string; message: string };
+
+/** 同じお子さんの選択を検証する（画面・サーバー共通）。 */
+export function checkChildSelection(grade: Grade, courseIds: string[], catalog: Map<string, PublicCourse | CourseView>): ChildSelectionCheck {
+  const seen = new Set<string>();
+  const chosen: Array<PublicCourse | CourseView> = [];
+  for (const id of courseIds) {
+    const c = catalog.get(id);
+    if (!c) return { ok: false, code: 'unknown', courseId: id, message: '選択した講座が見つかりません。画面を読み込み直してください。' };
+    if (seen.has(id)) return { ok: false, code: 'duplicate', courseId: id, message: `「${c.title}」が重複しています。` };
+    seen.add(id);
+    if (!c.targetGrades.includes(grade)) return { ok: false, code: 'grade', courseId: id, message: `「${c.title}」は${grade}の対象講座ではありません。` };
+    for (const other of chosen) {
+      if (coursesOverlap(c, other)) {
+        return { ok: false, code: 'overlap', courseId: id, otherCourseId: other.id, message: `「${c.title}」と「${other.title}」は日時が重なるため、同じお子さんは両方を受講できません。` };
+      }
+    }
+    chosen.push(c);
+  }
+  return { ok: true };
+}
+
+export { isGrade };
