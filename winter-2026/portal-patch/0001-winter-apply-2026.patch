diff --git a/scripts/seasonal-apply-demo/browser-demo.tsx b/scripts/seasonal-apply-demo/browser-demo.tsx
new file mode 100644
index 0000000..ea76f15
--- /dev/null
+++ b/scripts/seasonal-apply-demo/browser-demo.tsx
@@ -0,0 +1,151 @@
+// 冬期講習申込の確認環境（ブラウザ版）。本番と同じ画面コンポーネント・料金計算・DB関数（migration の SQL）を
+// ブラウザ内の PostgreSQL（PGlite）で動かす。本番の Supabase・請求・メールには接続しない。
+// ビルド: node scripts/seasonal-apply-demo/build-browser-demo.mjs <出力先>
+import { useEffect, useState } from 'react';
+import { createRoot } from 'react-dom/client';
+import { PGlite } from '@electric-sql/pglite';
+import migration from '../../supabase/migrations/20261021090000_seasonal_apply_capacity.sql';
+import snapshot from './portal-catalog-2026-10-20.json';
+import WinterApply from '../../app/winter/WinterApply';
+import ApplicationsAdmin from '../../app/portal/seasonal/applications/ApplicationsAdmin';
+import { DEMO_GRANT_OFFICE_VIEW, DEMO_IDS, demoDatabaseSql, sqlRpc, verificationBody, type DemoScenario } from '../../lib/seasonal-apply-demo-db';
+import {
+  applicationsCsv, loadAdminBoard, loadPublicCatalog, modifyApplication, submitApplication, updateCourseControl, updateSettings,
+  type PublicCatalog, type Rpc,
+} from '../../lib/seasonal-apply-service';
+import type { PortalCourse } from '../../lib/seasonal-apply-catalog';
+
+declare const LOGO_SRC: string;
+declare const CREST_SRC: string;
+
+type View = 'parent' | 'principal' | 'office';
+const snap = snapshot as unknown as { courses: PortalCourse[]; teachers: Record<string, string>; afternoonStart: string; capturedAt: string };
+
+let assets: Promise<{ pg: WebAssembly.Module; initdb: WebAssembly.Module; data: Blob }> | null = null;
+function loadAssets() {
+  assets ??= (async () => {
+    const [pg, initdb, data] = await Promise.all([
+      fetch('pglite.wasm').then(r => { if (!r.ok) throw new Error('pglite.wasm'); return r.arrayBuffer(); }).then(b => WebAssembly.compile(b)),
+      fetch('initdb.wasm').then(r => { if (!r.ok) throw new Error('initdb.wasm'); return r.arrayBuffer(); }).then(b => WebAssembly.compile(b)),
+      // 配信先が .data 形式を扱えないため、base64 テキストで受け取ってブラウザ内で戻す
+      fetch('pglite-data.b64.txt').then(r => { if (!r.ok) throw new Error('pglite-data'); return r.text(); })
+        .then(t => { const bin = atob(t.trim()); const u = new Uint8Array(bin.length); for (let i = 0; i < bin.length; i++) u[i] = bin.charCodeAt(i); return new Blob([u]); }),
+    ]);
+    return { pg, initdb, data };
+  })();
+  return assets;
+}
+
+async function createDb(scenario: DemoScenario): Promise<Rpc> {
+  const a = await loadAssets();
+  const db = new PGlite({ pgliteWasmModule: a.pg, initdbWasmModule: a.initdb, fsBundle: a.data });
+  const courses = scenario === 'verification' ? verificationBody(snap.courses) : snap.courses;
+  await db.exec(demoDatabaseSql(migration, { body: { courses, afternoonStart: snap.afternoonStart }, teachers: snap.teachers, published: true }));
+  await db.exec(DEMO_GRANT_OFFICE_VIEW);
+  await db.query(`select public.portal_seasonal_apply_settings_update($1,$2,gen_random_uuid(),0,'open',null,'確認環境の初期設定')`, [DEMO_IDS.campus, DEMO_IDS.principal]);
+  // 本番の Server Action と同じく、毎回この関数を通して DB 関数を呼ぶ
+  return sqlRpc((sql, params) => db.query(sql, params) as never);
+}
+
+const wrap = async <T,>(fn: () => Promise<T>) => {
+  try { return { ok: true as const, data: await fn() }; }
+  catch (e) {
+    const m = e instanceof Error ? e.message : String(e);
+    return { ok: false as const, error: /[ぁ-んァ-ン一-龥]/.test(m) ? m : '保存できませんでした。もう一度お試しください。' };
+  }
+};
+
+function Demo() {
+  const [scenario, setScenario] = useState<DemoScenario>('portal');
+  const [view, setView] = useState<View>(() => (['parent', 'principal', 'office'].includes(location.hash.slice(1)) ? location.hash.slice(1) as View : 'parent'));
+  const [rpc, setRpc] = useState<Rpc | null>(null);
+  const [error, setError] = useState('');
+  const [generation, setGeneration] = useState(0);
+  const [initial, setInitial] = useState<{ parent?: PublicCatalog; admin?: Awaited<ReturnType<typeof loadAdminBoard>> | { error: string } }>({});
+
+  useEffect(() => {
+    let alive = true;
+    setRpc(null); setError('');
+    createDb(scenario).then(r => { if (alive) setRpc(() => r); }).catch(e => { if (alive) setError(`確認環境を起動できませんでした（${e instanceof Error ? e.message : e}）。再読み込みしてください。`); });
+    return () => { alive = false; };
+  }, [scenario, generation]);
+
+  useEffect(() => {
+    if (!rpc) return;
+    let alive = true;
+    const actor = view === 'office' ? DEMO_IDS.office : DEMO_IDS.principal;
+    (view === 'parent'
+      ? loadPublicCatalog(rpc, DEMO_IDS.campus).then(c => alive && setInitial({ parent: c }))
+      : loadAdminBoard(rpc, DEMO_IDS.campus, actor).then(b => alive && setInitial({ admin: b })).catch(e => alive && setInitial({ admin: { error: String(e?.message ?? e) } })));
+    return () => { alive = false; };
+  }, [rpc, view]);
+
+  useEffect(() => {
+    const onHash = () => { const h = location.hash.slice(1); if (h === 'parent' || h === 'principal' || h === 'office') setView(h); };
+    window.addEventListener('hashchange', onHash);
+    return () => window.removeEventListener('hashchange', onHash);
+  }, []);
+
+  const actor = view === 'office' ? DEMO_IDS.office : DEMO_IDS.principal;
+  const go = (v: View) => { setInitial({}); setView(v); try { history.replaceState(null, '', `#${v}`); } catch { /* 表示だけ切り替える */ } };
+
+  return (
+    <>
+      <div className="demo-bar">
+        <div className="demo-inner">
+          <div className="demo-title">
+            <strong>冬期講習 申込の確認環境</strong>
+            <span>ブラウザの中だけで動きます。本番の申込・請求・メールにはつながっていません。画面・料金計算・定員の判定は本番用と同じプログラムとSQLです。</span>
+          </div>
+          <div className="demo-controls">
+            <div className="seg" role="tablist" aria-label="画面">
+              {([['parent', '保護者の申込'], ['principal', '職員（校長）'], ['office', '職員（閲覧のみ）']] as Array<[View, string]>).map(([v, label]) => (
+                <button key={v} id={`view-${v}`} role="tab" aria-selected={view === v} onClick={() => go(v)}>{label}</button>
+              ))}
+            </div>
+            <label className="demo-select">講座データ
+              <select id="scenario" value={scenario} onChange={e => { setInitial({}); setScenario(e.target.value as DemoScenario); }}>
+                <option value="portal">ポータルの現状（10/20時点・確定9講座）</option>
+                <option value="verification">検証用（下書き講座も仮の設定で受付中）</option>
+              </select>
+            </label>
+            <button id="reset" className="demo-reset" onClick={() => { setInitial({}); setGeneration(g => g + 1); }}>最初からやり直す</button>
+          </div>
+        </div>
+      </div>
+      {error && <p className="demo-error" role="alert">{error}</p>}
+      {!error && (!rpc || (view === 'parent' ? !initial.parent : !initial.admin)) && <p className="demo-loading">確認環境を準備しています…（初回は数秒かかります）</p>}
+      {rpc && view === 'parent' && initial.parent && (
+        <WinterApply
+          key={`p-${generation}-${scenario}`}
+          initial={initial.parent}
+          actions={{
+            refresh: () => loadPublicCatalog(rpc, DEMO_IDS.campus),
+            submit: (op, input) => submitApplication(rpc, DEMO_IDS.campus, op, input),
+          }}
+          logoSrc={LOGO_SRC}
+          crestSrc={CREST_SRC}
+          banner={scenario === 'verification' ? <div className="demo-note">検証用データ: ポータルで「下書き」の講座を、集団（「個別」を含む講座名は個別）・換算1講座の仮の設定で受付中にしています。</div> : undefined}
+        />
+      )}
+      {rpc && view !== 'parent' && initial.admin && (
+        'error' in initial.admin ? <p className="demo-error">{initial.admin.error}</p> : (
+          <ApplicationsAdmin
+            key={`a-${generation}-${scenario}-${view}`}
+            initial={{ ok: true, data: initial.admin }}
+            actions={{
+              load: () => wrap(() => loadAdminBoard(rpc, DEMO_IDS.campus, actor)),
+              settings: (op, rev, phase, closesAt, reason) => wrap(async () => { await updateSettings(rpc, DEMO_IDS.campus, actor, op, rev, phase, closesAt, reason); return true as const; }),
+              course: (op, courseId, rev, patch) => wrap(async () => { const r = await updateCourseControl(rpc, DEMO_IDS.campus, actor, op, courseId, rev, patch); return { overCapacity: r.overCapacity, applied: r.applied, capacity: r.capacity }; }),
+              modify: (op, args) => wrap(async () => { await modifyApplication(rpc, DEMO_IDS.campus, actor, op, args); return true as const; }),
+              csv: () => wrap(async () => applicationsCsv(await loadAdminBoard(rpc, DEMO_IDS.campus, actor))),
+            }}
+            links={{ portal: null, timetable: null, publicPage: '#parent' }}
+          />
+        )
+      )}
+    </>
+  );
+}
+
+createRoot(document.getElementById('app')!).render(<Demo />);
diff --git a/scripts/seasonal-apply-demo/build-browser-demo.mjs b/scripts/seasonal-apply-demo/build-browser-demo.mjs
new file mode 100644
index 0000000..5affe9b
--- /dev/null
+++ b/scripts/seasonal-apply-demo/build-browser-demo.mjs
@@ -0,0 +1,67 @@
+// 冬期講習申込の確認環境（ブラウザ版）を1枚の HTML と PGlite の実行ファイルに書き出す。
+//   node scripts/seasonal-apply-demo/build-browser-demo.mjs <出力ディレクトリ>
+import { build } from 'esbuild';
+import { copyFileSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+
+const root = resolve(import.meta.dirname, '../..');
+const out = resolve(process.argv[2] ?? join(root, 'tmp-seasonal-apply-demo'));
+mkdirSync(out, { recursive: true });
+
+// React はポータルと同じ版（node_modules の React 19）を同梱する。
+
+const dataUri = (file, mime) => `data:${mime};base64,${readFileSync(join(root, file)).toString('base64')}`;
+
+const result = await build({
+  entryPoints: [join(root, 'scripts/seasonal-apply-demo/browser-demo.tsx')],
+  bundle: true,
+  format: 'esm',
+  platform: 'browser',
+  target: 'es2022',
+  write: false,
+  outdir: out,
+  minify: true,
+  jsx: 'automatic',
+  tsconfig: join(root, 'tsconfig.json'),
+  loader: { '.sql': 'text', '.json': 'json', '.css': 'css' },
+  define: {
+    LOGO_SRC: JSON.stringify(dataUri('public/sundai-logo.png', 'image/png')),
+    CREST_SRC: JSON.stringify(dataUri('public/mi-crest.png', 'image/png')),
+    'process.env.NODE_ENV': '"production"',
+  },
+  logLevel: 'warning',
+});
+const js = result.outputFiles.find(f => f.path.endsWith('.js')).text;
+const css = result.outputFiles.filter(f => f.path.endsWith('.css')).map(f => f.text).join('\n');
+
+const html = `<meta charset="utf-8">
+<title>冬期講習 申込確認環境</title>
+<meta name="claude:viewport-fit-sides" content="cover">
+<style>
+:root { --bar-bg: #16263a; --bar-fg: #f2f5f9; --bar-muted: #b8c6d6; --bar-accent: #f0c419; --page-bg: #f7f9fc; --ink: #1b2733; color-scheme: light; }
+body { background: var(--page-bg); color: var(--ink); margin: 0; }
+.demo-bar { background: var(--bar-bg); color: var(--bar-fg); padding-block: 10px; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
+.demo-inner { max-width: 1320px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; justify-content: space-between; }
+.demo-title { display: grid; gap: 2px; min-width: 0; flex: 1 1 320px; font: 13px/1.5 -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif; }
+.demo-title strong { font-size: 15px; }
+.demo-title span { color: var(--bar-muted); }
+.demo-controls { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; font: 13px -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif; }
+.seg { display: inline-flex; border: 1px solid #3c5370; border-radius: 10px; overflow: hidden; }
+.seg button { background: transparent; color: var(--bar-fg); border: 0; padding: 8px 12px; font: inherit; cursor: pointer; min-height: 40px; }
+.seg button[aria-selected="true"] { background: var(--bar-accent); color: #1b2733; font-weight: 700; }
+.seg button:focus-visible, .demo-reset:focus-visible, .demo-select select:focus-visible { outline: 3px solid var(--bar-accent); outline-offset: 2px; }
+.demo-select { display: inline-flex; gap: 6px; align-items: center; color: var(--bar-muted); }
+.demo-select select { font: inherit; padding: 6px 8px; border-radius: 8px; border: 1px solid #3c5370; background: #fff; color: #1b2733; max-width: 100%; }
+.demo-reset { font: inherit; padding: 8px 12px; border-radius: 10px; border: 1px solid #3c5370; background: transparent; color: var(--bar-fg); cursor: pointer; min-height: 40px; }
+.demo-loading, .demo-error { max-width: 720px; margin: 40px auto; padding: 0 16px; font: 15px -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif; text-align: center; }
+.demo-error { color: #b42318; }
+.demo-note { background: #fff4dc; color: #5d3a00; font: 13px/1.5 -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif; padding: 8px 16px; text-align: center; }
+${css}
+</style>
+<div id="app"></div>
+<script type="module">${js.replace(/<\/script/g, '<\\/script')}</script>
+`;
+writeFileSync(join(out, 'winter-apply-demo.html'), html);
+writeFileSync(join(out, 'pglite-data.b64.txt'), readFileSync(join(root, 'node_modules/@electric-sql/pglite/dist/pglite.data')).toString('base64'));
+for (const f of ['pglite.wasm', 'initdb.wasm']) copyFileSync(join(root, 'node_modules/@electric-sql/pglite/dist', f), join(out, f));
+console.log(JSON.stringify({ out, htmlBytes: Buffer.byteLength(html), jsBytes: js.length, cssBytes: css.length }));
