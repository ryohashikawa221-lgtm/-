+                <dd><ul className={s.sessions}>{c.sessions.map(x => <li key={x.date + x.start}>{formatDate(x.date)} {formatTime(x.start)}〜{formatTime(x.end)}</li>)}</ul></dd>
+                <dt>担当</dt><dd>{c.teacher || '未定'}</dd>
+                <dt>持ち物</dt><dd>{c.belongings.trim() || '特になし'}</dd>
+                <dt>教材</dt><dd>{c.materials.trim() || '特になし'}</dd>
+                <dt>料金</dt>
+                <dd>{price != null ? `定価 ${formatUsd(price)}（${grade}・${c.kind ? COURSE_KIND_LABEL[c.kind] : ''}）。講座数割引・きょうだい割引は合計で自動計算します。` : '準備中です'}</dd>
+                <dt>残席</dt><dd>{c.status === 'open' ? `${c.remaining}席` : PUBLIC_STATUS_LABEL[c.status]}</dd>
+              </dl>
+            )}
+          </article>
+        );
+      })}
+      <div className={s.actions}>
+        <button type="button" className={`${s.btn} ${s.btnGhost}`} onClick={onBack}>学年の入力に戻る</button>
+        <button type="button" className={s.btn} onClick={onNext} disabled={busy}>確認へ進む</button>
+      </div>
+    </section>
+  );
+}
+
+function PriceSummary({ kids, byId, pricing }: { kids: Child[]; byId: Map<string, PublicCourse>; pricing: ReturnType<typeof priceSelection> | null }) {
+  let k = 0;
+  return (
+    <div className={s.summary} aria-live="polite">
+      <h2>お支払い金額</h2>
+      {kids.map((c, i) => {
+        if (!c.courseIds.length || !c.grade) return <div key={c.uid} className={s.sumKid}><b>{childLabel(c, i)}</b>（{c.grade || '学年未選択'}）<div className={s.small}>講座を選んでください</div></div>;
+        const p = pricing?.children[k++];
+        return (
+          <div key={c.uid} className={s.sumKid}>
+            <b>{childLabel(c, i)}</b>（{c.grade}・{c.courseIds.length}講座）
+            <ul style={{ margin: '4px 0', paddingLeft: 18 }}>{c.courseIds.map(id => <li key={id} className={s.small}>{byId.get(id)?.title}</li>)}</ul>
+            {p && <>
+              <div className={s.sumRow}><span>定価</span><span>{formatUsd(p.listPrice)}</span></div>
+              {p.countDiscount > 0 && <div className={s.sumRow}><span>講座数割引（{p.countUnits}講座）</span><span className={s.minus}>−{formatUsd(p.countDiscount)}</span></div>}
+              {p.siblingDiscount > 0 && <div className={s.sumRow}><span>きょうだい割引（{Math.round(p.siblingRate * 100)}%）</span><span className={s.minus}>−{formatUsd(p.siblingDiscount)}</span></div>}
+              <div className={s.sumRow}><b>小計</b><b>{formatUsd(p.amount)}</b></div>
+            </>}
+          </div>
+        );
+      })}
+      <div className={s.total}><span>お支払い合計</span><strong>{formatUsd(pricing?.total ?? 0)}</strong></div>
+      {pricing && (pricing.countDiscountTotal > 0 || pricing.siblingDiscountTotal > 0) && (
+        <p className={s.small} style={{ margin: '6px 0 0' }}>割引合計 −{formatUsd(pricing.countDiscountTotal + pricing.siblingDiscountTotal)}（講座数割引 {formatUsd(pricing.countDiscountTotal)}・きょうだい割引 {formatUsd(pricing.siblingDiscountTotal)}）</p>
+      )}
+      <p className={s.small} style={{ margin: '8px 0 0' }}>サンクスギビングと冬期の講座は、同じお子さんの分を合わせて講座数割引を計算します。きょうだい割引は受講料の高い順に、2人目20%・3人目以降30%です。</p>
+    </div>
+  );
+}
+
+function Done({ result }: { result: Extract<SubmitResult, { ok: true }> }) {
+  const at = new Date(result.submittedAt);
+  return (
+    <section className={`${s.card} ${s.done}`} aria-labelledby="done">
+      <h2 id="done">お申し込みを受け付けました</h2>
+      <p className={s.small}>受付番号</p>
+      <p className={s.receipt}>{result.receiptNo}</p>
+      <p className={s.small}>受付日時 {at.toLocaleString('ja-JP', { timeZone: 'America/Detroit' })}（ミシガン時間）</p>
+      <div style={{ textAlign: 'left', marginTop: 14 }}>
+        {result.summary.children.map(c => (
+          <div key={c.name} className={s.review}>
+            <h3>{c.name}さん（{c.grade}）</h3>
+            <ul>{c.courses.map(x => <li key={x.id}><b>{x.title}</b>（{x.termLabel}）<br /><span className={s.small}>{sessionText(x.sessions)}</span></li>)}</ul>
+            <div className={s.sumRow} style={{ marginTop: 6 }}><span>定価</span><span>{formatUsd(c.listPrice)}</span></div>
+            {c.countDiscount > 0 && <div className={s.sumRow}><span>講座数割引</span><span className={s.minus}>−{formatUsd(c.countDiscount)}</span></div>}
+            {c.siblingDiscount > 0 && <div className={s.sumRow}><span>きょうだい割引</span><span className={s.minus}>−{formatUsd(c.siblingDiscount)}</span></div>}
+            <div className={s.sumRow}><b>お支払額</b><b>{formatUsd(c.amount)}</b></div>
+          </div>
+        ))}
+        <div className={s.total}><span>お支払い合計</span><strong>{formatUsd(result.summary.total)}</strong></div>
+      </div>
+      <p className={s.notice} style={{ textAlign: 'left', marginTop: 14 }}>
+        この画面を印刷するか、受付番号を控えてください。お申し込み内容の変更・取消は、受付番号を添えて駿台ミシガン国際学院へご連絡ください。ご請求については、あらためてご案内します。
+      </p>
+      <div className={`${s.actions} ${s.noPrint}`} style={{ justifyContent: 'center' }}>
+        <button type="button" className={`${s.btn} ${s.btnGhost}`} onClick={() => window.print()}>この画面を印刷する</button>
+      </div>
+    </section>
+  );
+}
