+++ b/lib/seasonal-apply-service.ts
@@ -0,0 +1,381 @@
+/**
+ * 冬期講習申込のサーバー処理（Server Action・テスト・確認環境で共通）。
+ * - 料金は必ずここで再計算する。ブラウザから届いた金額は受け取らない。
+ * - 定員・締切・確定状態の最終判定は DB 関数がロック下で行う（ここでの事前判定は案内用）。
+ * - DB への経路は Rpc（本番: Supabase service_role の rpc、確認環境: 同じSQLを実行するPGlite）。
+ */
+import {
+  buildCatalog, checkChildSelection, toPublicCourse, planPhaseNow, PUBLIC_STATUS_LABEL,
+  type ApplySettings, type CourseControl, type CourseView, type PortalPlanBody, type PublicCourse, type PlanPhase,
+} from './seasonal-apply-catalog';
+import { formatUsd, isGrade, priceFamily, type FamilyPrice, type Grade } from './seasonal-apply-pricing';
+
+export type Rpc = (fn: string, args: Record<string, unknown>) => Promise<unknown>;
+
+type RawSnapshot = {
+  available: boolean;
+  planId?: string;
+  publishedRevision?: number | null;
+  body?: PortalPlanBody;
+  teachers?: Record<string, string>;
+  settings?: { phase: PlanPhase; closesAt: string | null; revision: number; updatedAt?: string | null };
+  controls?: Array<CourseControl & { updatedAt?: string }>;
+  counts?: Record<string, number>;
+  serverTime?: string;
+};
+
+function catalogFrom(raw: RawSnapshot, now: Date): CourseView[] {
+  const settings: ApplySettings = raw.settings ?? { phase: 'preparing', closesAt: null, revision: 0 };
+  return buildCatalog({
+    body: raw.body ?? null,
+    teachers: raw.teachers ?? {},
+    controls: (raw.controls ?? []).map(c => ({ ...c, priceMultiplier: c.priceMultiplier == null ? null : Number(c.priceMultiplier) })),
+    counts: raw.counts ?? {},
+    settings,
+    now,
+  });
+}
+
+export type PublicCatalog = {
+  available: boolean;
+  phase: PlanPhase;
+  closesAt: string | null;
+  publishedRevision: number | null;
+  courses: PublicCourse[];
+  loadedAt: string;
+};
+
+export async function loadPublicCatalog(rpc: Rpc, campusId: string, now = new Date()): Promise<PublicCatalog> {
+  const raw = (await rpc('portal_seasonal_apply_catalog', { p_campus: campusId })) as RawSnapshot;
+  if (!raw?.available) return { available: false, phase: 'preparing', closesAt: null, publishedRevision: null, courses: [], loadedAt: now.toISOString() };
+  const settings = raw.settings ?? { phase: 'preparing' as const, closesAt: null, revision: 0 };
+  return {
+    available: true,
+    phase: planPhaseNow(settings, now),
+    closesAt: settings.closesAt,
+    publishedRevision: raw.publishedRevision ?? null,
+    courses: catalogFrom(raw, now).map(toPublicCourse),
+    loadedAt: now.toISOString(),
+  };
+}
+
+export type ApplyInput = {
+  guardian: { name: string; email: string; phone: string; affiliation: string; note: string };
+  children: Array<{ name: string; grade: string; courseIds: string[] }>;
+  /** 画面に表示していた合計。照合だけに使い、保存する金額はサーバーで再計算する。 */
+  expectedTotal?: number;
+};
+
+export type ApplyIssue = { childIndex: number | null; courseId: string | null; title: string; message: string };
+
+export type SubmitResult =
+  | { ok: true; replay: boolean; receiptNo: string; submittedAt: string; pricing: FamilyPrice; summary: SubmittedSummary }
+  | { ok: false; code: string; message: string; issues: ApplyIssue[]; catalog?: PublicCatalog };
+
+export type SubmittedSummary = {
+  guardianName: string;
+  email: string;
+  children: Array<{ name: string; grade: string; courses: Array<{ id: string; title: string; termLabel: string; sessions: PublicCourse['sessions'] }> ; amount: number; listPrice: number; countDiscount: number; siblingDiscount: number; tuition: number }>;
+  total: number;
+};
+
+const clip = (v: unknown, n: number) => String(v ?? '').trim().slice(0, n);
+
+export function normalizeInput(raw: unknown): { ok: true; input: ApplyInput } | { ok: false; message: string } {
+  const r = (raw ?? {}) as Record<string, unknown>;
+  const g = (r.guardian ?? {}) as Record<string, unknown>;
+  const guardian = {
+    name: clip(g.name, 80), email: clip(g.email, 200).toLowerCase(), phone: clip(g.phone, 40),
+    affiliation: clip(g.affiliation, 40), note: clip(g.note, 1000),
+  };
+  if (!guardian.name) return { ok: false, message: '保護者のお名前を入力してください。' };
+  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(guardian.email)) return { ok: false, message: 'メールアドレスを確認してください。' };
+  if (!guardian.phone) return { ok: false, message: '電話番号を入力してください。' };
+  const kids = Array.isArray(r.children) ? r.children : [];
+  if (kids.length < 1 || kids.length > 6) return { ok: false, message: 'お子さんは1〜6人まで入力できます。' };
+  const children: ApplyInput['children'] = [];
+  for (const [i, k] of kids.entries()) {
+    const c = (k ?? {}) as Record<string, unknown>;
+    const name = clip(c.name, 60);
+    const grade = clip(c.grade, 4);
+    const courseIds = Array.isArray(c.courseIds) ? c.courseIds.map(x => String(x)) : [];
+    if (!name) return { ok: false, message: `${i + 1}人目のお子さんのお名前を入力してください。` };
+    if (!isGrade(grade)) return { ok: false, message: `${i + 1}人目のお子さんの学年を選んでください。` };
+    if (courseIds.length === 0) return { ok: false, message: `${name}さんの講座を1つ以上選んでください。` };
+    if (courseIds.length > 30) return { ok: false, message: '一度に申し込める講座数を超えています。' };
+    children.push({ name, grade, courseIds });
+  }
+  const keys = children.map(c => c.name.replace(/[\s　]/g, '').toLowerCase());
+  if (new Set(keys).size !== keys.length) return { ok: false, message: '同じお名前のお子さんが2回入力されています。' };
+  return { ok: true, input: { guardian, children } };
+}
+
+/** 料金だけを計算する（確認画面の表示用。保存時は submit 内で必ず再計算する）。 */
+export function priceSelection(catalog: Map<string, PublicCourse | CourseView>, children: ApplyInput['children']): FamilyPrice {
+  return priceFamily(children.map((c, i) => ({
+    key: String(i + 1),
+    grade: c.grade as Grade,
+    courses: c.courseIds.map(id => {
+      const v = catalog.get(id);
+      if (!v || v.countUnits == null || v.priceMultiplier == null) throw new Error('料金が確定していない講座が含まれています');
+      return { courseId: id, countUnits: v.countUnits, priceMultiplier: v.priceMultiplier };
+    }),
+  })));
+}
+
+const REASON_MESSAGE: Record<string, (title: string) => string> = {
+  full: t => `「${t}」は満席になりました。`,
+  closed: t => `「${t}」は受付を締め切りました。`,
+  preparing: t => `「${t}」は現在お申し込みいただけません。`,
+  grade: t => `「${t}」はお子さんの学年では受講できません。`,
+  changed: t => `「${t}」の内容が更新されました。内容を確認してください。`,
+  already_applied: t => `「${t}」はこのお子さんで既にお申し込み済みです。`,
+};
+
+type SubmitRpcResult = {
+  ok: boolean; code?: string; replay?: boolean; receiptNo?: string; submittedAt?: string;
+  issues?: Array<{ courseId: string; reason: string; title?: string; childPosition?: number; receiptNo?: string }>;
+  application?: { pricing: FamilyPrice; children: Array<{ name: string; grade: string; items: Array<{ courseId: string; state: string }> }> };
+};
+
+function successFrom(res: SubmitRpcResult, input: ApplyInput, byId: Map<string, CourseView>): SubmitResult {
+  const app = res.application!;
+  const summary: SubmittedSummary = {
+    guardianName: input.guardian.name,
+    email: input.guardian.email,
+    children: app.children.map((c, i) => {
+      const p = app.pricing.children[i];
+      return {
+        name: c.name, grade: c.grade,
+        courses: c.items.filter(it => it.state === 'active').map(it => {
+          const v = byId.get(it.courseId);
+          return { id: it.courseId, title: v?.title ?? '', termLabel: v?.termLabel ?? '', sessions: v?.sessions ?? [] };
+        }),
+        amount: p.amount, listPrice: p.listPrice, countDiscount: p.countDiscount, siblingDiscount: p.siblingDiscount, tuition: p.tuition,
+      };
+    }),
+    total: app.pricing.total,
+  };
+  return { ok: true, replay: !!res.replay, receiptNo: res.receiptNo!, submittedAt: res.submittedAt!, pricing: app.pricing, summary };
+}
+
+export async function submitApplication(rpc: Rpc, campusId: string, operationId: string, raw: unknown, now = new Date()): Promise<SubmitResult> {
+  const norm = normalizeInput(raw);
+  if (!norm.ok) return { ok: false, code: 'invalid', message: norm.message, issues: [] };
+  const input = norm.input;
+  // 画面に表示していた合計（照合用。保存する金額には使わない）
+  const shownTotal = typeof (raw as { expectedTotal?: unknown })?.expectedTotal === 'number' ? (raw as { expectedTotal: number }).expectedTotal : null;
+  const snap = (await rpc('portal_seasonal_apply_catalog', { p_campus: campusId })) as RawSnapshot;
+  if (!snap?.available) return { ok: false, code: 'not_open', message: '現在、お申し込みを受け付けていません。', issues: [] };
+  const views = catalogFrom(snap, now);
+  const byId = new Map(views.map(v => [v.id, v]));
+  // 再送（保存済みなのに応答が届かなかった場合）は、受付状態や残席の確認より先に、保存済みの結果を返す
+  const replay = (await rpc('portal_seasonal_apply_replay', { p_campus: campusId, p_operation: operationId, p_intent: input })) as SubmitRpcResult | null;
+  if (replay) {
+    if (!replay.ok) return { ok: false, code: 'operation_conflict', message: '送信内容が変わっています。画面を読み込み直してから、もう一度お申し込みください。', issues: [] };
+    return successFrom(replay, input, byId);
+  }
+  const publicCatalog = (): PublicCatalog => ({
+    available: true, phase: planPhaseNow(snap.settings!, now), closesAt: snap.settings?.closesAt ?? null,
+    publishedRevision: snap.publishedRevision ?? null, courses: views.map(toPublicCourse), loadedAt: now.toISOString(),
+  });
+  const phase = planPhaseNow(snap.settings ?? { phase: 'preparing', closesAt: null, revision: 0 }, now);
+  if (phase !== 'open') {
+    return { ok: false, code: phase === 'closed' ? 'deadline' : 'not_open', message: phase === 'closed' ? 'お申し込みの受付は終了しました。' : '現在、お申し込みを受け付けていません。', issues: [] };
+  }
+  // 事前確認（日時重複・学年・受付状態）。最終判定はDBがロック下で行う。
+  const issues: ApplyIssue[] = [];
+  input.children.forEach((child, i) => {
+    const check = checkChildSelection(child.grade as Grade, child.courseIds, byId);
+    if (!check.ok) issues.push({ childIndex: i, courseId: check.courseId, title: byId.get(check.courseId)?.title ?? '', message: `${child.name}さん: ${check.message}` });
+    for (const id of child.courseIds) {
+      const v = byId.get(id);
+      if (v && v.status !== 'open') issues.push({ childIndex: i, courseId: id, title: v.title, message: `${child.name}さん: 「${v.title}」は${PUBLIC_STATUS_LABEL[v.status]}のため申し込めません。` });
+    }
+  });
+  // 同じ講座を複数のお子さんで選んだ場合の残席も事前に見る
+  const demand = new Map<string, number>();
+  input.children.forEach(c => c.courseIds.forEach(id => demand.set(id, (demand.get(id) ?? 0) + 1)));
+  for (const [id, n] of demand) {
+    const v = byId.get(id);
+    if (v && v.status === 'open' && n > v.remaining) {
+      issues.push({ childIndex: null, courseId: id, title: v.title, message: `「${v.title}」の残席は${v.remaining}席です（選択 ${n}人）。` });
+    }
+  }
+  if (issues.length) return { ok: false, code: 'unavailable', message: '選択した講座の状態が変わりました。下の内容を確認してください。', issues, catalog: publicCatalog() };
+
+  const pricing = priceSelection(byId, input.children);
+  if (shownTotal != null && shownTotal !== pricing.total) {
+    return {
+      ok: false, code: 'price_changed',
+      message: `講座の設定が更新され、お支払い金額が ${formatUsd(shownTotal)} から ${formatUsd(pricing.total)} に変わりました。金額を確認して、もう一度「申し込む」を押してください。`,
+      issues: [], catalog: publicCatalog(),
+    };
+  }
+  const request = {
+    intent: input,
+    publishedRevision: snap.publishedRevision,
+    guardian: input.guardian,
+    children: input.children.map((c, i) => ({
+      position: i + 1, name: c.name, grade: c.grade,
+      items: c.courseIds.map(id => {
+        const v = byId.get(id)!;
+        return { courseId: id, countUnits: v.countUnits, priceMultiplier: v.priceMultiplier, controlRevision: v.controlRevision };
+      }),
+    })),
+    pricing,
+    total: pricing.total,
+  };
+  const res = (await rpc('portal_seasonal_apply_submit', { p_campus: campusId, p_operation: operationId, p_request: request })) as SubmitRpcResult;
+  if (!res.ok) {
+    const map: Record<string, string> = {
+      not_open: '現在、お申し込みを受け付けていません。',
+      deadline: 'お申し込みの受付は終了しました。',
+      catalog_changed: '講座の内容が更新されました。お手数ですが内容を確認してから、もう一度送信してください。',
+      operation_conflict: '送信内容が変わっています。画面を読み込み直してから、もう一度お申し込みください。',
+      family_exists: 'このメールアドレスでは、すでにお申し込みを受け付けています。講座やお子さんの追加・変更は、駿台ミシガン国際学院へご連絡ください（料金はまとめて再計算します）。',
+      unavailable: '選択した講座の状態が変わりました。下の内容を確認してください。',
+    };
+    const issueList: ApplyIssue[] = (res.issues ?? []).map(x => {
+      const childIndex = x.childPosition ? x.childPosition - 1 : null;
+      const childName = childIndex != null ? input.children[childIndex]?.name : null;
+      const title = x.title ?? byId.get(x.courseId)?.title ?? '';
+      const base = (REASON_MESSAGE[x.reason] ?? (t => `「${t}」は申し込めません。`))(title);
+      const suffix = x.reason === 'already_applied' && x.receiptNo ? `（受付番号 ${x.receiptNo}）` : '';
+      return { childIndex, courseId: x.courseId, title, message: `${childName ? `${childName}さん: ` : ''}${base}${suffix}` };
+    });
+    let catalog: PublicCatalog | undefined;
+    if (res.code === 'unavailable' || res.code === 'catalog_changed') catalog = await loadPublicCatalog(rpc, campusId, now);
+    return { ok: false, code: res.code ?? 'error', message: map[res.code ?? ''] ?? '送信できませんでした。', issues: issueList, catalog };
+  }
+  return successFrom(res, input, byId);
+}
+
+// ------------------------------------------------------------------------------------------------
+// 職員
+// ------------------------------------------------------------------------------------------------
+export type AdminApplication = {
+  id: string; receiptNo: string; state: 'active' | 'cancelled'; revision: number;
+  guardianName: string; email: string; phone: string; affiliation: string; note: string;
+  total: number; submittedAt: string; updatedAt: string; cancelReason: string | null;
+  pricing: FamilyPrice;
+  children: Array<{
+    id: string; position: number; name: string; grade: Grade;
+    listPrice: number; countDiscount: number; tuition: number; siblingRate: number; siblingDiscount: number; amount: number;
+    items: Array<{ id: string; courseId: string; countUnits: number; priceMultiplier: number; state: 'active' | 'cancelled'; createdAt: string; cancelledAt: string | null; cancelReason: string | null; byStaff: boolean }>;
+  }>;
+};
+
+export type AdminBoard = {
+  available: boolean;
+  canManage: boolean;
+  planState?: string;
+  publicationEnabled?: boolean;
+  bodySource?: 'draft' | 'published';
+  settings: { phase: PlanPhase; closesAt: string | null; revision: number; updatedAt: string | null };
+  phaseNow: PlanPhase;
+  courses: CourseView[];
+  applications: AdminApplication[];
+  audit: Array<{ id: number; action: string; target: string; detail: Record<string, unknown>; occurredAt: string; actor: string }>;
+};
+
+const num = (v: unknown) => Number(v ?? 0);
+
+export async function loadAdminBoard(rpc: Rpc, campusId: string, actorId: string, now = new Date()): Promise<AdminBoard> {
+  const raw = (await rpc('portal_seasonal_apply_admin_board', { p_campus: campusId, p_actor: actorId })) as RawSnapshot & {
+    canManage: boolean; planState?: string; publicationEnabled?: boolean; bodySource?: 'draft' | 'published';
+    applications?: AdminApplication[]; audit?: AdminBoard['audit'];
+  };
+  const settings = { phase: 'preparing' as PlanPhase, closesAt: null, revision: 0, updatedAt: null, ...(raw.settings ?? {}) };
+  return {
+    available: !!raw.available,
+    canManage: !!raw.canManage,
+    planState: raw.planState,
+    publicationEnabled: raw.publicationEnabled,
+    bodySource: raw.bodySource,
+    settings: { phase: settings.phase, closesAt: settings.closesAt, revision: settings.revision, updatedAt: settings.updatedAt ?? null },
+    phaseNow: planPhaseNow(settings, now),
+    courses: raw.available ? catalogFrom(raw, now) : [],
+    applications: (raw.applications ?? []).map(a => ({
+      ...a, total: num(a.total),
+      children: a.children.map(c => ({
+        ...c, listPrice: num(c.listPrice), countDiscount: num(c.countDiscount), tuition: num(c.tuition),
+        siblingRate: num(c.siblingRate), siblingDiscount: num(c.siblingDiscount), amount: num(c.amount),
+        items: c.items.map(i => ({ ...i, priceMultiplier: num(i.priceMultiplier) })),
+      })),
+    })),
+    audit: raw.audit ?? [],
+  };
+}
+
+export async function updateSettings(rpc: Rpc, campusId: string, actorId: string, operationId: string,
+  expectedRevision: number, phase: PlanPhase, closesAt: string | null, reason: string) {
+  return rpc('portal_seasonal_apply_settings_update', {
+    p_campus: campusId, p_actor: actorId, p_operation: operationId, p_expected_revision: expectedRevision,
+    p_phase: phase, p_closes_at: closesAt, p_reason: reason,
+  }) as Promise<{ ok: true; settings: unknown }>;
+}
+
+export type CoursePatch = { capacity?: number | null; manualState?: 'open' | 'closed'; priceMultiplier?: number | null; subject?: string | null; reason?: string };
+
+export async function updateCourseControl(rpc: Rpc, campusId: string, actorId: string, operationId: string,
+  courseId: string, expectedRevision: number, patch: CoursePatch) {
+  return rpc('portal_seasonal_apply_course_update', {
+    p_campus: campusId, p_actor: actorId, p_operation: operationId, p_course: courseId,
+    p_expected_revision: expectedRevision, p_patch: patch,
+  }) as Promise<{ ok: true; revision: number; applied: number; capacity: number; overCapacity: boolean }>;
+}
+
+/**
+ * 申込の取消・追加。残る講座（＋追加分）で料金を再計算してから DB に渡す。
+ * 既存の講座は申込時に保存した換算数・倍率を使い、後から倍率を変えても過去の申込額は動かさない。
+ */
+export async function modifyApplication(rpc: Rpc, campusId: string, actorId: string, operationId: string, args: {
+  applicationId: string; expectedRevision: number; cancelItemIds: string[]; add: Array<{ childId: string; courseId: string }>; reason: string;
+}, now = new Date()) {
+  const board = await loadAdminBoard(rpc, campusId, actorId, now);
+  const app = board.applications.find(a => a.id === args.applicationId);
+  if (!app) throw new Error('申込が見つかりません');
+  if (app.revision !== args.expectedRevision) throw new Error('他の職員がこの申込を変更しました。画面を読み込み直してください');
+  const byId = new Map(board.courses.map(c => [c.id, c]));
+  const cancel = new Set(args.cancelItemIds);
+  const addPayload: Array<{ childId: string; courseId: string; countUnits: number; priceMultiplier: number }> = [];
+  const children = app.children.map(ch => {
+    const keep = ch.items.filter(i => i.state === 'active' && !cancel.has(i.id))
+      .map(i => ({ courseId: i.courseId, countUnits: i.countUnits, priceMultiplier: i.priceMultiplier }));
+    for (const a of args.add.filter(x => x.childId === ch.id)) {
+      const v = byId.get(a.courseId);
+      if (!v || v.countUnits == null || v.priceMultiplier == null) throw new Error('料金が確定していない講座は追加できません');
+      keep.push({ courseId: v.id, countUnits: v.countUnits, priceMultiplier: v.priceMultiplier });
+      addPayload.push({ childId: ch.id, courseId: v.id, countUnits: v.countUnits, priceMultiplier: v.priceMultiplier });
+    }
+    const check = checkChildSelection(ch.grade, keep.map(k => k.courseId), byId);
+    if (!check.ok) throw new Error(`${ch.name}さん: ${check.message}`);
+    return { key: String(ch.position), grade: ch.grade, courses: keep };
+  });
+  if (addPayload.length !== args.add.length) throw new Error('追加先のお子さんが見つかりません');
+  const pricing = priceFamily(children);
+  return rpc('portal_seasonal_apply_modify', {
+    p_campus: campusId, p_actor: actorId, p_operation: operationId, p_application: args.applicationId,
+    p_expected_revision: args.expectedRevision, p_cancel_items: args.cancelItemIds.length ? args.cancelItemIds : null,
+    p_add: addPayload.length ? addPayload : null, p_reason: args.reason, p_pricing: pricing,
+  }) as Promise<{ ok: true; application: AdminApplication }>;
+}
+
+/** 請求担当へ渡す一覧（1行=お子さん×講座）。金額は申込に保存した値をそのまま出す。 */
+export function applicationsCsv(board: AdminBoard): string {
+  const byId = new Map(board.courses.map(c => [c.id, c]));
+  const rows: string[][] = [['受付番号', '状態', '受付日時', '保護者', 'メール', '電話', '在籍', 'お子さん', '学年', '講座', '期間', '講座状態',
+    'お子さん定価', '講座数割引', 'きょうだい割引', 'お子さん支払額', 'ご家庭合計']];
+  for (const a of board.applications) {
+    for (const ch of a.children) {
+      for (const it of ch.items) {
+        const v = byId.get(it.courseId);
+        rows.push([a.receiptNo, a.state === 'active' ? '受付' : '取消', a.submittedAt, a.guardianName, a.email, a.phone, a.affiliation,
+          ch.name, ch.grade, v?.title ?? it.courseId, v?.termLabel ?? '', it.state === 'active' ? '受講' : '取消',
+          String(ch.listPrice), String(ch.countDiscount), String(ch.siblingDiscount), String(ch.amount), String(a.total)]);
+      }
+    }
+  }
+  return '﻿' + rows.map(r => r.map(x => /[",\n]/.test(x) ? `"${x.replace(/"/g, '""')}"` : x).join(',')).join('\n');
+}
