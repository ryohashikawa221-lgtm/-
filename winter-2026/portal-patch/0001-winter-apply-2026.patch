+test('講座はポータルの公開データから作られ、未公開・受付前は申し込めない', async () => {
+  const { db, rpc } = await setup({ published: false, scenario: 'portal' });
+  try {
+    const cat = await loadPublicCatalog(rpc, campus, NOW);
+    assert.equal(cat.available, false);
+    await assert.rejects(updateSettings(rpc, campus, principal, randomUUID(), 0, 'open', null, ''), /公開されていない/);
+  } finally { await db.close(); }
+  const { db: db2, rpc: rpc2 } = await setup({ scenario: 'portal' });
+  try {
+    const cat = await loadPublicCatalog(rpc2, campus, NOW);
+    assert.equal(cat.available, true);
+    assert.equal(cat.courses.length, 68);
