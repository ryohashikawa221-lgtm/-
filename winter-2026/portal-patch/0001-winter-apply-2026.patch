+test('申込成功で受付番号を返し、金額はサーバーで再計算して保存する（サンクスギビング+冬期を合算）', async () => {
+  const { db, rpc } = await setup({ scenario: 'portal' });
+  try {
+    await open(rpc);
+    const op = randomUUID();
+    const input = {
+      guardian,
+      children: [
+        { name: '駿台 太郎', grade: '小5', courseIds: [KEISAN_TG, KEISAN_W1, KOBETSU_READY] },
+        { name: '駿台 次郎', grade: '中1', courseIds: [CHU1] },
+      ],
+      // ブラウザから金額を送っても使われない
+      total: 1, pricing: { total: 1 },
+    };
+    const r = await submitApplication(rpc, campus, op, input, NOW);
+    assert.equal(r.ok, true, JSON.stringify(r));
+    if (!r.ok) return;
+    assert.equal(r.receiptNo, 'MIW26-0001');
+    // 太郎: 小学生 換算3 → 240/3=80 × (1+1+1.4)=272、定価 100×3.4=340
+    // 次郎: 中学生 1講座 120 → 20%引き 96
+    const expected = priceFamily([
+      { key: '1', grade: '小5', courses: [
+        { courseId: KEISAN_TG, countUnits: 1, priceMultiplier: 1 },
+        { courseId: KEISAN_W1, countUnits: 1, priceMultiplier: 1 },
+        { courseId: KOBETSU_READY, countUnits: 1, priceMultiplier: 1.4 }] },
+      { key: '2', grade: '中1', courses: [{ courseId: CHU1, countUnits: 1, priceMultiplier: 1 }] },
+    ]);
+    assert.equal(expected.children[0].tuition, 272);
+    assert.equal(expected.children[0].listPrice, 340);
+    assert.equal(expected.children[1].amount, 96);
+    assert.equal(r.summary.total, expected.total);
+    assert.equal(r.summary.total, 368);
+    const rows = await db.query<{ total: string }>('select total::text from public.seasonal_apply_applications');
+    assert.equal(Number(rows.rows[0].total), 368);
+    const kids = await db.query<{ amount: string; sibling_discount: string }>('select amount::text, sibling_discount::text from public.seasonal_apply_children order by position');
+    assert.deepEqual(kids.rows.map(k => Number(k.amount)), [272, 96]);
+    const cat = await loadPublicCatalog(rpc, campus, NOW);
+    assert.equal(cat.courses.find(c => c.id === KOBETSU_READY)!.remaining, 2, '個別の初期定員3から1減る');
+    assert.equal(cat.courses.find(c => c.id === KEISAN_W1)!.remaining, 11, '集団の初期定員12から1減る');
+
+    // 二重クリック・通信再試行: 同じ操作IDは同じ受付を返し、行を増やさない
+    const again = await submitApplication(rpc, campus, op, input, NOW);
+    assert.equal(again.ok && again.receiptNo, 'MIW26-0001');
+    assert.equal(again.ok && again.replay, true);
+    const count = await db.query<{ n: number }>('select count(*)::int n from public.seasonal_apply_items');
+    assert.equal(count.rows[0].n, 4);
+    // 同じ操作IDで内容が違えば拒否
+    const conflict = await submitApplication(rpc, campus, op, { guardian, children: [{ name: '駿台 太郎', grade: '小5', courseIds: [KEISAN_TG] }] }, NOW);
+    assert.equal(!conflict.ok && conflict.code, 'operation_conflict');
+    // 別の操作IDで同じご家庭（メールアドレス）から再度申し込んでも二重登録しない（追加・変更は職員が既存の申込を変更）
+    const dup = await submitApplication(rpc, campus, randomUUID(), { guardian: { ...guardian, email: 'HANAKO@example.com' }, children: [{ name: '駿台　太郎', grade: '小5', courseIds: [TANKEN] }] }, NOW);
+    assert.equal(!dup.ok && dup.code, 'family_exists');
+    assert.ok(!dup.ok && !/MIW26/.test(dup.message), '他の申込の受付番号は出さない');
+  } finally { await db.close(); }
+});
