+/**
+ * 冬期講習申込の確認環境・DBテスト用の最小データベース。
+ * 本番の Supabase には接続しない。申込の DB 関数（supabase/migrations/20261021090000_seasonal_apply_capacity.sql）を
+ * そのまま実行するため、参照先のテーブルを最小限の形で用意する。
+ * 職員権限の判定関数 2 つは本番 migration の定義を写したもの（出典をコメントに記載）。
+ */
+import type { Rpc } from './seasonal-apply-service';
+import type { PortalCourse } from './seasonal-apply-catalog';
+
+export const DEMO_IDS = {
+  campus: '00000000-0000-4000-8000-0000000000c1',
+  plan: '00000000-0000-4000-8000-0000000000a1',
+  principal: '00000000-0000-4000-8000-0000000000e1',
+  office: '00000000-0000-4000-8000-0000000000e2',
+  roleOffice: '00000000-0000-4000-8000-0000000000f2',
+  rolePrincipal: '00000000-0000-4000-8000-0000000000f1',
+} as const;
+
+const STUB_SQL = `
+do $$ begin
+  if not exists (select 1 from pg_roles where rolname='anon') then create role anon; end if;
+  if not exists (select 1 from pg_roles where rolname='authenticated') then create role authenticated; end if;
+  if not exists (select 1 from pg_roles where rolname='service_role') then create role service_role; end if;
+end $$;
+create schema if not exists auth;
+create schema if not exists app_private;
+create table public.campuses(id uuid primary key, code text, name text, is_active boolean not null default true);
+create table auth.users(id uuid primary key, email text, deleted_at timestamptz, banned_until timestamptz);
+create table public.users(id uuid primary key, campus_id uuid, email text, display_name text, family_id uuid, is_active boolean not null default true);
+create table public.teachers(id uuid primary key, campus_id uuid, name text, is_active boolean not null default true, sort_order int default 0);
+create table public.roles(id uuid primary key, code text unique, name text);
+create table public.permissions(id uuid primary key default gen_random_uuid(), code text unique not null, name text, description text);
+create table public.role_permissions(role_id uuid, permission_id uuid, primary key(role_id, permission_id));
+create table public.role_assignments(user_id uuid, campus_id uuid, role_id uuid);
+create table public.staff_permission_overrides(user_id uuid, campus_id uuid, permission_id uuid, allowed boolean, primary key(user_id, campus_id, permission_id));
+create table app_private.staff_email_change_operations(target_user_id uuid, status text);
+create table public.seasonal_plans(
+  id uuid primary key, campus_id uuid not null references public.campuses(id), cycle text not null, academic_year int not null default 2026,
+  revision int not null default 1, published_revision int, state text not null default 'draft',
+  draft_body jsonb not null, published_body jsonb, publication_enabled boolean not null default false,
+  issuance_enabled boolean not null default false, updated_by uuid, updated_at timestamptz not null default now());
+
+-- 出典: supabase/migrations/20260827230000_staff_email_change.sql（本文そのまま）
+create or replace function app_private.staff_identity_email_matches(p_user_id uuid)
+returns boolean language sql stable security definer set search_path = '' as $f$
+  select p_user_id is not null
+     and exists (select 1 from public.users u join auth.users au on au.id = u.id and au.deleted_at is null
+                  and lower(btrim(au.email::text)) = lower(btrim(u.email)) where u.id = p_user_id and u.family_id is null)
+     and not exists (select 1 from app_private.staff_email_change_operations op where op.target_user_id = p_user_id and op.status = 'prepared')
+$f$;
+-- 出典: supabase/migrations/20260810010000_payment_reversal_and_correction.sql（本文そのまま）
+create or replace function app_private.actor_has_staff_permission(p_actor uuid,p_permission text,p_campus uuid)
+returns boolean language sql stable security definer set search_path='' as $f$
+  select exists(select 1 from public.users u where u.id=p_actor and u.campus_id=p_campus and u.is_active and u.family_id is null)
+    and (select count(*) from public.role_assignments ra join public.roles r on r.id=ra.role_id
+         where ra.user_id=p_actor and ra.campus_id=p_campus and r.code in ('principal','office_staff','full_time_staff','accounting_staff','part_time_staff'))=1
+    and coalesce((select spo.allowed from public.staff_permission_overrides spo join public.permissions p on p.id=spo.permission_id
+                  where spo.user_id=p_actor and spo.campus_id=p_campus and p.code=p_permission),
+                 exists(select 1 from public.role_assignments ra join public.role_permissions rp on rp.role_id=ra.role_id
+                        join public.permissions p on p.id=rp.permission_id where ra.user_id=p_actor and ra.campus_id=p_campus and p.code=p_permission));
+$f$;
+`;
+
+const q = (s: string) => `'${s.replace(/'/g, "''")}'`;
+
+export type DemoScenario = 'portal' | 'verification';
+
+/** 検証用: ポータルで「下書き」の講座を、仮の値で確定扱いにする（確認環境の画面上に必ず明記する）。 */
+export function verificationBody(courses: PortalCourse[]): PortalCourse[] {
+  return courses.map(c => c.status === 'ready' ? c : {
+    ...c,
+    status: 'ready',
+    instructionMode: c.instructionMode ?? (/個別/.test(c.title) ? 'individual' : 'group'),
+    billingUnits: c.billingUnits ?? 1,
+    unitBasis: c.unitBasis?.trim() ? c.unitBasis : '【検証用の仮設定】換算1講座',
+  });
+}
+
+export function demoSeedSql(args: {
+  body: { afternoonStart?: string; courses: PortalCourse[] };
+  teachers: Record<string, string>;
+  published: boolean;
+}): string {
+  const { campus, plan, principal, office, rolePrincipal, roleOffice } = DEMO_IDS;
+  const teacherRows = Object.entries(args.teachers).map(([id, name], i) => `(${q(id)}, ${q(campus)}, ${q(name)}, true, ${i})`).join(',');
+  const body = JSON.stringify({ version: 5, afternoonStart: args.body.afternoonStart ?? '12:30', courses: args.body.courses });
+  return `
+insert into public.campuses(id, code, name) values (${q(campus)}, 'MI', '駿台ミシガン国際学院（確認環境）');
+insert into auth.users(id, email) values (${q(principal)}, 'principal@demo.invalid'), (${q(office)}, 'office@demo.invalid');
+insert into public.users(id, campus_id, email, display_name) values
+  (${q(principal)}, ${q(campus)}, 'principal@demo.invalid', '確認用 校長'),
+  (${q(office)}, ${q(campus)}, 'office@demo.invalid', '確認用 事務職員');
+insert into public.roles(id, code, name) values (${q(rolePrincipal)}, 'principal', '校長'), (${q(roleOffice)}, 'office_staff', '事務職員');
+insert into public.role_assignments values (${q(principal)}, ${q(campus)}, ${q(rolePrincipal)}), (${q(office)}, ${q(campus)}, ${q(roleOffice)});
+${teacherRows ? `insert into public.teachers(id, campus_id, name, is_active, sort_order) values ${teacherRows};` : ''}
+insert into public.seasonal_plans(id, campus_id, cycle, state, revision, published_revision, draft_body, published_body, publication_enabled)
+values (${q(plan)}, ${q(campus)}, '2026-thanksgiving-winter', ${args.published ? "'published'" : "'draft'"}, 1, ${args.published ? 1 : 'null'},
+  ${q(body)}::jsonb, ${args.published ? `${q(body)}::jsonb` : 'null'}, ${args.published ? 'true' : 'false'});
+`;
+}
+
+/** 事務職員に「閲覧のみ」を個別付与する（権限の違いを確認するため）。 */
+export const DEMO_GRANT_OFFICE_VIEW = `
+insert into public.staff_permission_overrides(user_id, campus_id, permission_id, allowed)
+select '${DEMO_IDS.office}', '${DEMO_IDS.campus}', id, true from public.permissions where code = 'seasonal_applications.view';
+`;
+
+/** 参照先テーブル → 初期データ（校長ロール等）→ 申込 migration の順で組み立てる。 */
+export function demoDatabaseSql(migrationSql: string, seed: Parameters<typeof demoSeedSql>[0]): string {
+  return STUB_SQL + '\n' + demoSeedSql(seed) + '\n' + migrationSql;
+}
+
+const RPC_NAMES = new Set([
+  'portal_seasonal_apply_catalog', 'portal_seasonal_apply_submit', 'portal_seasonal_apply_replay', 'portal_seasonal_apply_admin_board',
+  'portal_seasonal_apply_settings_update', 'portal_seasonal_apply_course_update', 'portal_seasonal_apply_modify',
+]);
+
+type QueryFn = (sql: string, params: unknown[]) => Promise<{ rows: Array<Record<string, unknown>> }>;
+
+function toParam(v: unknown): unknown {
+  if (v === null || v === undefined) return null;
+  if (Array.isArray(v) && v.every(x => typeof x === 'string' && /^[0-9a-f-]{36}$/i.test(x))) return `{${v.join(',')}}`;
+  if (typeof v === 'object') return JSON.stringify(v);
+  return String(v);
+}
+
+/** SQL を直接実行できる接続（PGlite / node-postgres）を Rpc に変換する。 */
+export function sqlRpc(query: QueryFn): Rpc {
+  return async (fn, args) => {
+    if (!RPC_NAMES.has(fn)) throw new Error(`unknown rpc ${fn}`);
+    const keys = Object.keys(args);
+    for (const k of keys) if (!/^p_[a-z_]+$/.test(k)) throw new Error('bad arg');
+    const sql = `select public.${fn}(${keys.map((k, i) => `${k} => $${i + 1}`).join(', ')}) as r`;
+    const res = await query(sql, keys.map(k => toParam(args[k])));
+    const r = res.rows[0]?.r;
+    return typeof r === 'string' ? JSON.parse(r) : r;
+  };
+}
