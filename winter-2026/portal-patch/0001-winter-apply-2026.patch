diff --git a/scripts/e2e-seasonal-apply.mjs b/scripts/e2e-seasonal-apply.mjs
new file mode 100644
index 0000000..1e4fcae
--- /dev/null
+++ b/scripts/e2e-seasonal-apply.mjs
@@ -0,0 +1,177 @@
+// 冬期講習申込の画面確認（確認環境 SEASONAL_APPLY_DEMO=1 / verification シナリオで起動したサーバーに対して実行）。
+//   SEASONAL_APPLY_E2E_URL=http://localhost:3100 SEASONAL_APPLY_E2E_OUT=./out node scripts/e2e-seasonal-apply.mjs
+import { chromium, devices } from 'playwright';
+import assert from 'node:assert/strict';
+import { mkdirSync } from 'node:fs';
+
+const BASE = process.env.SEASONAL_APPLY_E2E_URL ?? 'http://localhost:3100';
+const OUT = process.env.SEASONAL_APPLY_E2E_OUT ?? './e2e-out';
+mkdirSync(OUT, { recursive: true });
+const log = (...a) => console.log('✔', ...a);
+
+const browser = await chromium.launch(process.env.PW_CHROMIUM ? { executablePath: process.env.PW_CHROMIUM } : {});
+const phone = await browser.newContext({ ...devices['iPhone 13'], locale: 'ja-JP' });
+const desk = await browser.newContext({ viewport: { width: 1360, height: 900 }, locale: 'ja-JP' });
+const shot = (page, name) => page.screenshot({ path: `${OUT}/${name}.png`, fullPage: false });
+const card = (page, title) => page.locator('article', { has: page.getByRole('heading', { name: title, exact: true }) }).first();
+const barTotal = async page => (await page.locator('button[aria-expanded] strong').first().innerText()).trim();
+
+async function pickGrade(page, idx, grade) {
+  await page.getByRole('group', { name: /^学年/ }).nth(idx).getByRole('button', { name: grade, exact: true }).click();
+}
+
+// ---- 1. スマホ: 学年入力 → 対象講座のみ → 選択・解除で合計が変わる → 重複防止 → きょうだい ----
+const p = await phone.newPage();
+await p.goto(`${BASE}/winter`);
+await p.getByRole('heading', { name: 'お子さんの学年を選んでください' }).waitFor();
+assert.ok(!(await p.content()).match(/お子様|お子さま/), '表記「お子さん」に統一');
+await shot(p, '01-phone-step1-grade');
+await pickGrade(p, 0, '小5');
+await p.getByLabel('お名前').first().fill('駿台 太郎');
+await p.getByRole('button', { name: '＋ きょうだいを追加' }).click();
+await pickGrade(p, 1, '高1');
+await p.getByLabel('お名前').nth(1).fill('駿台 花子');
+await shot(p, '02-phone-step1-siblings');
+await p.getByRole('button', { name: '講座を選ぶ' }).click();
+await p.getByRole('heading', { name: '小学生が受講できる講座（小5）' }).waitFor();
+log('学年入力の後、学年区分つきで講座一覧を表示');
+const titles = await p.locator('article h3').allInnerTexts();
+assert.ok(!titles.some(t => /高校数学|中学数学のまとめ|TOEFL/.test(t)), '小5の対象外の講座を表示しない');
+log(`小5の対象講座のみ表示（${titles.length}件）`);
+assert.equal(await barTotal(p), '$0');
+await card(p, '算数・数学探検隊　〜作って、試して、算数・数学の不思議を発見しよう！〜').getByRole('button', { name: '選択する' }).click();
+assert.equal(await barTotal(p), '$100');
+const coaster = card(p, 'コースターづくり');
+await coaster.getByText('日時が重なるため選べません').first().waitFor();
+assert.ok(await coaster.getByRole('button', { name: '時間が重なります' }).isDisabled());
+log('同じお子さんの同じ日時の講座は選択不可（理由を表示）');
+await shot(p, '03-phone-step2-overlap');
+// 個別（サンクスギビング）を追加 → 2講座 180/2×(1+1.4)=216
+await p.getByRole('button', { name: 'サンクスギビング', exact: true }).click();
+await card(p, '個別').getByRole('button', { name: '選択する' }).click();
+assert.equal(await barTotal(p), '$216');
+log('選択のたびに合計が変わる（集団+個別1.4倍、サンクスギビングと冬期を合算: $216）');
+await card(p, '個別').getByRole('button', { name: '選択を外す' }).click();
+assert.equal(await barTotal(p), '$100');
+await card(p, '個別').getByRole('button', { name: '選択する' }).click();
+log('解除で合計が戻る');
+// 詳細
+await card(p, '個別').getByRole('button', { name: '詳しく見る' }).click();
+await card(p, '個別').getByText('実施日時（全3回）').waitFor();
+await shot(p, '04-phone-course-detail');
+// 2人目（高1）: 2コマ連続 版画 → 140×1.6=224
+await p.getByRole('tab', { name: /駿台 花子さん/ }).click();
+await p.getByRole('heading', { name: '高校生が受講できる講座（高1）' }).waitFor();
+await p.getByRole('button', { name: 'すべて', exact: true }).first().click();
+await card(p, '版画で年賀状を作ろう').getByRole('button', { name: '選択する' }).click();
+// 216 と 224 → 低い方(216)を20%引き 173 → 合計 397
+assert.equal(await barTotal(p), '$397');
+log('きょうだい2人: 受講料の低い方を20%引き・2コマ連続1.6倍（合計 $397）');
+await p.locator('button[aria-expanded]').filter({ hasText: 'お支払い合計' }).click();
+await shot(p, '05-phone-price-breakdown');
+await p.locator('button[aria-expanded]').filter({ hasText: 'お支払い合計' }).click();
+
+// ---- 2. 確認 → 二重クリックしても1件 ----
+await p.getByRole('button', { name: '確認へ進む' }).last().click();
+await p.getByRole('heading', { name: 'お申し込み内容の確認' }).waitFor();
+await p.getByLabel('保護者のお名前').fill('駿台 保護者');
+await p.getByLabel('メールアドレス', { exact: false }).first().fill('parent@example.com');
+await p.getByLabel('メールアドレス（確認のため、もう一度）').fill('parent@example.com');
+await p.getByLabel('電話番号').fill('248-555-0100');
+await shot(p, '06-phone-step3-confirm');
+const submitBtn = p.getByRole('button', { name: '$397で申し込む' });
+await submitBtn.dblclick();
+await p.getByRole('heading', { name: 'お申し込みを受け付けました' }).waitFor();
+const receipt = (await p.locator('text=/^MIW26-\\d{4}$/').first().innerText()).trim();
+log(`受付完了・受付番号 ${receipt}`);
+await shot(p, '07-phone-done');
+
+// ---- 3. 職員画面: 申込1件・残席 ----
+const a = await desk.newPage();
+await a.goto(`${BASE}/portal/seasonal/applications`);
+await a.getByRole('heading', { name: '冬期講習2026 申込・定員管理' }).waitFor();
+await a.getByRole('tab', { name: /申込一覧/ }).click();
+assert.equal(await a.locator(`text=${receipt}`).count(), 1, '二重クリックでも申込は1件');
+log('二重クリックでも申込は1件');
+await a.getByRole('tab', { name: /講座と定員/ }).click();
+await shot(a, '08-admin-courses');
+
+// 定員変更: 探検隊を 1 名に（申込済み1 → 満席）
+const tankenRow = a.locator('tr', { hasText: '算数・数学探検隊' }).first();
+await tankenRow.getByRole('button', { name: '変更' }).click();
+const editor = a.locator('tr').filter({ has: a.getByText('定員（名）') });
+await editor.getByRole('checkbox').uncheck();
+await editor.getByRole('spinbutton').first().fill('1');
+await editor.getByRole('button', { name: '保存' }).click();
+await a.getByText('設定を保存しました').waitFor();
+await a.locator('tr', { hasText: '算数・数学探検隊' }).first().getByText('満席').waitFor();
+log('定員を変更 → 満席表示');
+
+// ---- 4. 別の保護者: 満席は選べない／選択後に締切 → 送信時に案内 ----
+const p2 = await (await browser.newContext({ ...devices['iPhone 13'], locale: 'ja-JP' })).newPage();
+await p2.goto(`${BASE}/winter`);
+await pickGrade(p2, 0, '小4');
+await p2.getByRole('button', { name: '講座を選ぶ' }).click();
+const full = card(p2, '算数・数学探検隊　〜作って、試して、算数・数学の不思議を発見しよう！〜');
+assert.ok(await full.getByRole('button', { name: '満席' }).isDisabled());
+log('満席の講座は保護者画面で選択不可');
+await shot(p2, '09-phone-full');
+await card(p2, '計算マスターへの道　1章①').getByRole('button', { name: '選択する' }).click();
+await card(p2, 'ペン習字').getByRole('button', { name: '選択する' }).click();
+// 職員が途中締切
+const keisanRow = a.locator('tr', { hasText: '計算マスターへの道　1章①' }).first();
+await keisanRow.getByRole('button', { name: '締め切る' }).click();
+await a.getByRole('dialog').getByLabel(/理由/).fill('教室の都合');
+await shot(a, '08b-admin-close-dialog');
+await a.getByRole('dialog').getByRole('button', { name: '締め切る' }).click();
+await a.getByText('受付を締め切りました').waitFor();
+log('職員が講座を途中締切');
+await p2.getByRole('button', { name: '確認へ進む' }).last().click();
+await p2.getByText(/計算マスターへの道　1章①」は締切のため、選択から外しました/).waitFor();
+log('選択後に締切 → 確認画面へ進む時点で自動で外して案内');
+await p2.getByLabel('お子さんのお名前').fill('西 一郎');
+await p2.getByLabel('保護者のお名前').fill('西 保護者');
+await p2.getByLabel('メールアドレス', { exact: false }).first().fill('nishi@example.com');
+await p2.getByLabel('メールアドレス（確認のため、もう一度）').fill('nishi@example.com');
+await p2.getByLabel('電話番号').fill('000');
+// 送信直前に別講座も締切 → 送信時にサーバーが拒否して案内
+const penRow = a.locator('tr', { hasText: 'ペン習字' }).first();
+await penRow.getByRole('button', { name: '締め切る' }).click();
+await a.getByRole('dialog').getByRole('button', { name: '締め切る' }).click();
+await a.getByText('受付を締め切りました').waitFor();
+await p2.getByRole('button', { name: /で申し込む$/ }).click();
+await p2.getByRole('alert').getByText(/状態が変わりました/).waitFor();
+await shot(p2, '10-phone-closed-on-submit');
+log('送信時に締切を再確認し、分かりやすく案内（申込は保存されない）');
+
+// ---- 5. 取消で残席が戻る・閲覧のみ職員 ----
+await a.getByRole('tab', { name: /申込一覧/ }).click();
+await a.getByRole('button', { name: new RegExp(receipt) }).click();
+await a.getByRole('checkbox', { name: /算数・数学探検隊.*取消対象/ }).check();
+await a.getByPlaceholder('取消・変更の理由（必須）').fill('保護者から電話');
+await a.getByRole('button', { name: '選択した講座を取消' }).click();
+await a.getByRole('dialog').getByRole('button', { name: '取り消す' }).click();
+await a.getByText('残席と料金を更新しました').waitFor();
+await shot(a, '11-admin-after-cancel');
+await a.getByRole('tab', { name: /講座と定員/ }).click();
