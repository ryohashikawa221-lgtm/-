+    board = await loadAdminBoard(rpc, campus, principal, NOW);
+    await updateSettings(rpc, campus, principal, randomUUID(), board.settings.revision, 'open', '2026-10-01T00:00:00Z', '一次締切');
+    const late = await submitApplication(rpc, campus, randomUUID(), { guardian: { ...guardian, email: 'd@example.com' }, children: [{ name: 'D', grade: '小4', courseIds: [KEISAN_TG] }] }, NOW);
+    assert.equal(!late.ok && late.code, 'deadline');
