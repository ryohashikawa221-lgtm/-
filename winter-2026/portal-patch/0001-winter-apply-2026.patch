+/**
+ * 2026 サンクスギビング・冬期講習 申込料金（画面表示とサーバー保存で同じ関数を使う）。
+ *
+ * 基準: 2025年度「MI Winter2025.pdf」の通常受講料金・きょうだい割引表。
+ *   1講座 = 90分×3回。講座数は「講座数割引に数える換算数」の合計で数える。
+ *   P(学年, n) = 下表（5講座以降は1講座ごとに加算）。
+ *
+ * 計算順（すべてドル単位の整数で確定させる）:
+ *   1. 定価      = 1講座料金 × Σ(換算数 × 料金倍率)            … 四捨五入でドル
+ *   2. 受講料    = P(n) / n × Σ(換算数 × 料金倍率)             … 四捨五入でドル（n = Σ換算数）
+ *   3. 講座数割引 = 定価 − 受講料
+ *   4. きょうだい割引: 受講料の高い順に 1人目0%・2人目20%・3人目以降30%
+ *      割引額 = 受講料 × 率 の1ドル未満切り捨て（= 割引後の受講料は1ドル未満切り上げ）。
+ *      PDF の表（例: 中学2講座 $216 → 20%引 $173、高校2講座 $252 → 30%引 $177）と一致する。
+ *   5. 支払額 = 受講料 − きょうだい割引
+ * 料金倍率（個別1.4・2コマ連続1.6 など）と換算数は別の値として受け取る。
+ * きょうだい間で講座数は合算しない。同じお子さんのサンクスギビングと冬期は合算する。
+ */
+
+export const SEASONAL_APPLY_PRICING_VERSION = '2026-winter-apply-v1';
+
+export type GradeBand = 'elementary' | 'middle' | 'high';
+
+export const GRADE_BAND_LABEL: Record<GradeBand, string> = {
+  elementary: '小学生',
+  middle: '中学生',
+  high: '高校生',
+};
+
+const TIERS: Record<GradeBand, { base: readonly number[]; extra: number }> = {
+  elementary: { base: [0, 100, 180, 240, 280], extra: 60 },
+  middle: { base: [0, 120, 216, 288, 336], extra: 72 },
+  high: { base: [0, 140, 252, 336, 392], extra: 84 },
+};
+
+export const SIBLING_DISCOUNT_RATES = [0, 0.2, 0.3] as const;
+
+export const GRADES = ['小1', '小2', '小3', '小4', '小5', '小6', '中1', '中2', '中3', '高1', '高2', '高3'] as const;
+export type Grade = typeof GRADES[number];
+
+export function isGrade(value: unknown): value is Grade {
+  return typeof value === 'string' && (GRADES as readonly string[]).includes(value);
+}
+
+export function gradeBand(grade: Grade): GradeBand {
+  if (grade.startsWith('小')) return 'elementary';
+  if (grade.startsWith('中')) return 'middle';
+  return 'high';
+}
+
+/** 換算数 n 講座ぶんの受講料（講座数割引適用後・倍率なし）。 */
+export function tierPrice(band: GradeBand, units: number): number {
+  if (!Number.isInteger(units) || units < 0 || units > 100) throw new Error('講座換算数を確認してください');
+  const t = TIERS[band];
+  return units <= 4 ? t.base[units] : t.base[4] + t.extra * (units - 4);
+}
+
+export type PricedCourseInput = {
+  courseId: string;
+  /** 講座数割引に数える換算数（正の整数）。 */
+  countUnits: number;
+  /** 料金倍率（集団標準1.0、個別1.4、2コマ連続1.6 など）。 */
+  priceMultiplier: number;
+};
+
+export type ChildPriceInput = {
+  key: string;
+  grade: Grade;
+  courses: PricedCourseInput[];
+};
+
+export type ChildPrice = {
+  key: string;
+  grade: Grade;
+  courseCount: number;
+  countUnits: number;
+  listPrice: number;
+  countDiscount: number;
+  tuition: number;
+  siblingRank: number | null;
+  siblingRate: number;
+  siblingDiscount: number;
+  amount: number;
+};
+
+export type FamilyPrice = {
+  pricingVersion: string;
+  children: ChildPrice[];
+  listTotal: number;
+  countDiscountTotal: number;
+  tuitionTotal: number;
+  siblingDiscountTotal: number;
+  total: number;
+};
+
+/** 倍率は小数第2位まで。浮動小数の誤差を避けるため100倍の整数で扱う。 */
+function multiplierHundredths(m: number): number {
+  if (!Number.isFinite(m) || m <= 0 || m > 10) throw new Error('料金倍率を確認してください');
+  const h = Math.round(m * 100);
+  if (Math.abs(h - m * 100) > 1e-6) throw new Error('料金倍率は小数第2位までで設定してください');
+  return h;
+}
+
+/** 正の有理数 num/den を四捨五入（0.5は切り上げ）した整数。 */
+function roundHalfUp(num: bigint, den: bigint): number {
+  return Number((num * 2n + den) / (den * 2n));
+}
+
+export function priceChild(input: ChildPriceInput): Omit<ChildPrice, 'siblingRank' | 'siblingRate' | 'siblingDiscount' | 'amount'> {
+  const band = gradeBand(input.grade);
+  const seen = new Set<string>();
+  let units = 0;
+  let weighted = 0n; // Σ(換算数 × 倍率×100)
+  for (const c of input.courses) {
+    if (seen.has(c.courseId)) throw new Error('同じ講座が重複しています');
+    seen.add(c.courseId);
+    if (!Number.isInteger(c.countUnits) || c.countUnits < 1 || c.countUnits > 100) throw new Error('講座換算数を確認してください');
+    units += c.countUnits;
+    weighted += BigInt(c.countUnits) * BigInt(multiplierHundredths(c.priceMultiplier));
+  }
+  if (units === 0) {
+    return { key: input.key, grade: input.grade, courseCount: 0, countUnits: 0, listPrice: 0, countDiscount: 0, tuition: 0 };
+  }
+  const base = BigInt(tierPrice(band, 1));
+  const tier = BigInt(tierPrice(band, units));
+  const listPrice = roundHalfUp(base * weighted, 100n);
+  const tuition = roundHalfUp(tier * weighted, BigInt(units) * 100n);
+  return {
+    key: input.key,
+    grade: input.grade,
+    courseCount: input.courses.length,
+    countUnits: units,
+    listPrice,
+    countDiscount: listPrice - tuition,
+    tuition,
+  };
+}
+
+export function priceFamily(children: ChildPriceInput[]): FamilyPrice {
+  const keys = new Set<string>();
+  const priced = children.map((child, index) => {
+    if (keys.has(child.key)) throw new Error('お子さんの区別ができません');
+    keys.add(child.key);
+    return { index, p: priceChild(child) };
+  });
+  // 受講料の高い順。同額は入力順（同額なら割引額は同じなので結果は変わらない）。
+  const ranked = priced.filter(x => x.p.tuition > 0).sort((a, b) => b.p.tuition - a.p.tuition || a.index - b.index);
+  const rankByIndex = new Map<number, number>();
+  ranked.forEach((x, i) => rankByIndex.set(x.index, i + 1));
+  const out: ChildPrice[] = priced.map(({ index, p }) => {
+    const rank = rankByIndex.get(index) ?? null;
+    const rate = rank == null ? 0 : SIBLING_DISCOUNT_RATES[Math.min(rank - 1, SIBLING_DISCOUNT_RATES.length - 1)];
+    // 率は 0.2 / 0.3 なので 10倍した整数で計算し、割引額は切り捨て。
+    const siblingDiscount = Math.floor((p.tuition * Math.round(rate * 10)) / 10);
+    return { ...p, siblingRank: rank, siblingRate: rate, siblingDiscount, amount: p.tuition - siblingDiscount };
+  });
+  const sum = (f: (c: ChildPrice) => number) => out.reduce((s, c) => s + f(c), 0);
+  return {
+    pricingVersion: SEASONAL_APPLY_PRICING_VERSION,
+    children: out,
+    listTotal: sum(c => c.listPrice),
+    countDiscountTotal: sum(c => c.countDiscount),
+    tuitionTotal: sum(c => c.tuition),
+    siblingDiscountTotal: sum(c => c.siblingDiscount),
+    total: sum(c => c.amount),
+  };
+}
+
+export function formatUsd(amount: number): string {
+  return `$${amount.toLocaleString('en-US')}`;
+}
