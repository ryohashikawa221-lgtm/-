+// 公開ページ /winter — 2026 サンクスギビング・冬期講習のお申し込み（保護者向け・ログイン不要）。
+import type { Metadata } from 'next';
+import Link from 'next/link';
+import { seasonalApplyBackend } from '@/lib/seasonal-apply-server';
+import { loadPublicCatalog, type PublicCatalog } from '@/lib/seasonal-apply-service';
+import WinterApply from './WinterApply';
+import { refreshWinterCatalog, submitWinterApplication } from './actions';
+import s from './winter.module.css';
+
+export const dynamic = 'force-dynamic';
+export const metadata: Metadata = {
+  title: '2026年度 サンクスギビング・冬期講習のお申し込み｜駿台ミシガン国際学院',
+  description: '駿台ミシガン国際学院 2026年度 サンクスギビング・冬期講習のご案内とお申し込み',
+};
+
+export default async function WinterPage() {
+  const backend = await seasonalApplyBackend();
+  let initial: PublicCatalog;
+  try {
+    initial = await loadPublicCatalog(backend.rpc, backend.campusId);
+  } catch {
+    initial = { available: false, phase: 'preparing', closesAt: null, publishedRevision: null, courses: [], loadedAt: new Date().toISOString() };
+  }
+  const banner = backend.demo ? (
+    <div className={s.demoBanner}>
+      確認環境です（本番の申込・請求には反映されません）。講座は 2026/10/20 時点のポータル登録内容
+      {backend.demo.scenario === 'verification' ? '。検証のため、下書きの講座を仮の設定で受付中にしています' : ''}。
+      　<Link href="/portal/seasonal/applications">職員画面</Link>
+    </div>
+  ) : undefined;
+  return (
+    <WinterApply
+      initial={initial}
+      actions={{ refresh: refreshWinterCatalog, submit: submitWinterApplication }}
+      logoSrc="/sundai-logo.png"
+      crestSrc="/mi-crest.png"
+      banner={banner}
+    />
+  );
+}
