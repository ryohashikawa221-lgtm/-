+test('取消・変更で残席と料金が正しく更新され、操作履歴が残る', async () => {
+  const { db, rpc } = await setup({ scenario: 'portal' });
+  try {
+    await open(rpc);
+    const r = await submitApplication(rpc, campus, randomUUID(), { guardian, children: [
+      { name: '長男', grade: '中1', courseIds: [CHU1, TANKEN] },   // 216
+      { name: '長女', grade: '小5', courseIds: [KEISAN_W1] },       // 100 → 20%引 80
+    ] }, NOW);
+    assert.equal(r.ok, true);
+    assert.equal(r.ok && r.summary.total, 216 + 80);
+    let board = await loadAdminBoard(rpc, campus, principal, NOW);
+    let app = board.applications[0];
+    // 長男の1講座を取消 → 長男 120、長女 100 → 長女が20%引きのまま（120 > 100）
+    const item = app.children[0].items.find(i => i.courseId === TANKEN)!;
+    await modifyApplication(rpc, campus, principal, randomUUID(), { applicationId: app.id, expectedRevision: app.revision, cancelItemIds: [item.id], add: [], reason: '保護者から電話で取消' }, NOW);
+    board = await loadAdminBoard(rpc, campus, principal, NOW);
+    app = board.applications[0];
+    assert.equal(app.total, 120 + 80);
+    assert.equal(board.courses.find(c => c.id === TANKEN)!.remaining, 12);
