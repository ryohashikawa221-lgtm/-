+    const input = { guardian, children: [{ name: 'A', grade: '小4', courseIds: [KEISAN_W1] }], expectedTotal: 100 };
+    const first = await submitApplication(rpc, campus, op, input, NOW);
+    assert.equal(first.ok, true);
+    board = await loadAdminBoard(rpc, campus, principal, NOW);
+    await updateSettings(rpc, campus, principal, randomUUID(), board.settings.revision, 'closed', null, '受付終了');
+    const retry = await submitApplication(rpc, campus, op, input, NOW);
+    assert.equal(retry.ok && retry.replay, true, JSON.stringify(retry));
+    assert.equal(retry.ok && retry.receiptNo, first.ok && first.receiptNo);
+  } finally { await db.close(); }
+});
+
+test('画面の金額と送信時の金額が違えば保存せずに知らせる（ブラウザの金額は保存には使わない）', async () => {
+  const { db, rpc } = await setup({ scenario: 'portal' });
+  try {
+    await open(rpc);
+    const board = await loadAdminBoard(rpc, campus, principal, NOW);
+    // 保護者が $100 と表示された後に、職員が料金倍率を 2.0 に変更
+    await updateCourseControl(rpc, campus, principal, randomUUID(), KEISAN_W1, board.courses.find(c => c.id === KEISAN_W1)!.controlRevision, { priceMultiplier: 2 });
+    const r = await submitApplication(rpc, campus, randomUUID(), { guardian, children: [{ name: 'A', grade: '小4', courseIds: [KEISAN_W1] }], expectedTotal: 100 }, NOW);
+    assert.equal(!r.ok && r.code, 'price_changed');
+    assert.match(!r.ok ? r.message : '', /\$100 から \$200/);
+    const n = await db.query<{ n: number }>('select count(*)::int n from public.seasonal_apply_applications');
+    assert.equal(n.rows[0].n, 0);
+    // 表示金額を送らなくても、保存額はサーバーの再計算（$200）
+    const ok = await submitApplication(rpc, campus, randomUUID(), { guardian, children: [{ name: 'A', grade: '小4', courseIds: [KEISAN_W1] }], expectedTotal: 200 }, NOW);
+    assert.equal(ok.ok && ok.summary.total, 200);
+  } finally { await db.close(); }
+});
+
+test('職員が同じ講座をきょうだい2人へ同時に追加しても、席を二重に数えない', async () => {
+  const { db, rpc } = await setup({ scenario: 'portal' });
+  try {
+    await open(rpc);
+    let board = await loadAdminBoard(rpc, campus, principal, NOW);
+    await updateCourseControl(rpc, campus, principal, randomUUID(), KEISAN_W1, board.courses.find(c => c.id === KEISAN_W1)!.controlRevision, { capacity: 2 });
+    const r = await submitApplication(rpc, campus, randomUUID(), { guardian, children: [
+      { name: '兄', grade: '小6', courseIds: [TANKEN] }, { name: '弟', grade: '小4', courseIds: [KEISAN_TG] },
+    ] }, NOW);
+    assert.equal(r.ok, true);
+    board = await loadAdminBoard(rpc, campus, principal, NOW);
+    const app = board.applications[0];
+    await modifyApplication(rpc, campus, principal, randomUUID(), { applicationId: app.id, expectedRevision: app.revision, cancelItemIds: [],
+      add: app.children.map(c => ({ childId: c.id, courseId: KEISAN_W1 })), reason: '電話で追加' }, NOW);
+    board = await loadAdminBoard(rpc, campus, principal, NOW);
+    assert.equal(board.courses.find(c => c.id === KEISAN_W1)!.applied, 2);
+    assert.equal(board.courses.find(c => c.id === KEISAN_W1)!.status, 'full');
+  } finally { await db.close(); }
+});
diff --git a/lib/__tests__/seasonal-apply-pricing.test.ts b/lib/__tests__/seasonal-apply-pricing.test.ts
new file mode 100644
index 0000000..4a4545e
--- /dev/null
+++ b/lib/__tests__/seasonal-apply-pricing.test.ts
@@ -0,0 +1,205 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { priceChild, priceFamily, tierPrice, type Grade } from '../seasonal-apply-pricing';
+import {
+  autoMultiplier, buildCatalog, checkChildSelection, courseShape, parseSlot, guessSubject, toPublicCourse,
+  type PortalCourse, type CourseView,
+} from '../seasonal-apply-catalog';
+
+const std = (id: string, mult = 1, units = 1) => ({ courseId: id, countUnits: units, priceMultiplier: mult });
+const courses = (n: number, mult = 1) => Array.from({ length: n }, (_, i) => std(`c${i}`, mult));
+
+test('通常料金表（MI Winter2025.pdf）と一致する', () => {
+  const table: Record<string, number[]> = {
+    小4: [100, 180, 240, 280, 340, 400],
+    中1: [120, 216, 288, 336, 408, 480],
+    高1: [140, 252, 336, 392, 476, 560],
+  };
+  for (const [grade, prices] of Object.entries(table)) {
+    prices.forEach((price, i) => {
+      const p = priceChild({ key: 'a', grade: grade as Grade, courses: courses(i + 1) });
+      assert.equal(p.tuition, price, `${grade} ${i + 1}講座`);
+      assert.equal(p.listPrice, tierPrice(grade.startsWith('小') ? 'elementary' : grade.startsWith('中') ? 'middle' : 'high', 1) * (i + 1));
+      assert.equal(p.countDiscount, p.listPrice - p.tuition);
+    });
+  }
+});
+
+test('きょうだい割引表（2人20%・3人30%）の1〜4講座と一致する（割引後は1ドル未満切り上げ）', () => {
+  const twenty: Record<string, number[]> = { 小4: [80, 144, 192, 224], 中1: [96, 173, 231, 269], 高1: [112, 202, 269, 314] };
+  const thirty: Record<string, number[]> = { 小4: [70, 126, 168, 196], 中1: [84, 152, 202, 236], 高1: [98, 177, 236, 275] };
+  for (const grade of ['小4', '中1', '高1'] as Grade[]) {
+    for (let n = 1; n <= 4; n++) {
+      // 1人目は受講料が最も高くなるよう 10講座、2人目・3人目が対象学年 n 講座。
+      const fam = priceFamily([
+        { key: 'big', grade: '高3', courses: courses(10) },
+        { key: 'two', grade, courses: courses(n) },
+      ]);
+      assert.equal(fam.children[1].amount, twenty[grade][n - 1], `20% ${grade} ${n}`);
+      const fam3 = priceFamily([
+        { key: 'big', grade: '高3', courses: courses(10) },
+        { key: 'mid', grade: '高3', courses: courses(9) },
+        { key: 'three', grade, courses: courses(n) },
+      ]);
+      assert.equal(fam3.children[2].amount, thirty[grade][n - 1], `30% ${grade} ${n}`);
+    }
+  }
+});
+
+test('2人受講は受講料が低い方を20%引き、きょうだい間で講座数を合算しない', () => {
+  const fam = priceFamily([
+    { key: 'a', grade: '小5', courses: courses(2) }, // 180
+    { key: 'b', grade: '中2', courses: courses(1) }, // 120
+  ]);
+  assert.equal(fam.children[0].tuition, 180);
+  assert.equal(fam.children[1].tuition, 120); // 合算すれば 3講座料金になるが、しない
+  assert.equal(fam.children[0].siblingDiscount, 0);
+  assert.equal(fam.children[1].siblingDiscount, 24);
+  assert.equal(fam.total, 180 + 96);
+});
+
+test('3人受講は受講料が高い順に 割引なし・20%・30%', () => {
+  const fam = priceFamily([
+    { key: 'low', grade: '小4', courses: courses(1) },  // 100 → 30%
+    { key: 'high', grade: '高2', courses: courses(2) }, // 252 → 0%
+    { key: 'mid', grade: '中1', courses: courses(1) },  // 120 → 20%
+  ]);
+  const by = Object.fromEntries(fam.children.map(c => [c.key, c]));
+  assert.equal(by.high.siblingRate, 0);
+  assert.equal(by.mid.siblingRate, 0.2);
+  assert.equal(by.low.siblingRate, 0.3);
+  assert.equal(by.mid.amount, 96);
+  assert.equal(by.low.amount, 70);
+  assert.equal(fam.total, 252 + 96 + 70);
+});
+
+test('講座を選んでいないお子さんはきょうだい割引の人数に数えない', () => {
+  const fam = priceFamily([
+    { key: 'a', grade: '小4', courses: courses(1) },
+    { key: 'b', grade: '小5', courses: [] },
+  ]);
+  assert.equal(fam.children[0].siblingDiscount, 0);
+  assert.equal(fam.total, 100);
+});
+
+test('個別1.4倍・2コマ連続1.6倍・混合受講（倍率と換算数は別）', () => {
+  // 中学生: 集団1 + 個別1 → 換算2講座 216/2=108 → 108*(1+1.4)=259.2 → $259
+  const mixed = priceChild({ key: 'a', grade: '中1', courses: [std('g'), std('i', 1.4)] });
+  assert.equal(mixed.listPrice, 120 + 168);
+  assert.equal(mixed.tuition, 259);
+  // 高校生: 2コマ連続(倍率1.6・換算1) + 集団1 → 252/2*(1.6+1)=327.6 → $328
+  const dbl = priceChild({ key: 'b', grade: '高2', courses: [std('d', 1.6), std('g')] });
+  assert.equal(dbl.listPrice, 224 + 140);
+  assert.equal(dbl.tuition, 328);
+  // 換算数2として数える設定にした場合は講座数が増える（倍率とは独立）
+  const dbl2 = priceChild({ key: 'c', grade: '高2', courses: [std('d', 1.6, 2), std('g')] });
+  assert.equal(dbl2.countUnits, 3);
+  assert.equal(dbl2.tuition, Math.round((336 / 3) * (3.2 + 1)));
+});
+
+test('サンクスギビングと冬期は同じお子さんで合算して講座数割引', () => {
+  const p = priceChild({ key: 'a', grade: '小4', courses: [std('thanksgiving-1'), std('winter1-1'), std('winter2-1')] });
+  assert.equal(p.tuition, 240);
+});
+
+test('入力の誤りは拒否する', () => {
+  assert.throws(() => priceChild({ key: 'a', grade: '小4', courses: [std('x'), std('x')] }));
+  assert.throws(() => priceChild({ key: 'a', grade: '小4', courses: [std('x', 1.234)] }));
+  assert.throws(() => priceChild({ key: 'a', grade: '小4', courses: [std('x', 1, 0)] }));
+  assert.throws(() => priceFamily([{ key: 'a', grade: '小4', courses: [] }, { key: 'a', grade: '小4', courses: [] }]));
+});
+
+test('時間枠の読み取り・2コマ連続の判定・倍率の自動決定', () => {
+  assert.deepEqual(parseSlot('2026-12-21@14:00-17:00'), { date: '2026-12-21', start: '14:00', end: '17:00' });
+  assert.deepEqual(parseSlot('2026-12-21:2'), { date: '2026-12-21', start: '12:30', end: '14:00' });
+  const s = (start: string, end: string) => ['21', '22', '23'].map(d => ({ date: `2026-12-${d}`, start, end }));
+  assert.equal(courseShape(s('09:00', '10:30')), 'standard');
+  assert.equal(courseShape(s('14:00', '17:00')), 'double');
+  assert.equal(courseShape(s('09:00', '10:30').slice(0, 1)), 'nonstandard');
+  assert.equal(autoMultiplier('group', 'standard'), 1);
+  assert.equal(autoMultiplier('individual', 'standard'), 1.4);
+  assert.equal(autoMultiplier('group', 'double'), 1.6);
+  assert.equal(autoMultiplier('individual', 'double'), null);
+  assert.equal(autoMultiplier('group', 'nonstandard'), null);
+  assert.equal(autoMultiplier(null, 'standard'), null);
+  assert.equal(guessSubject('計算マスターへの道'), '算数・数学');
+  assert.equal(guessSubject('マンスリー対策　小３　算数'), 'テスト対策');
+  assert.equal(guessSubject('版画で年賀状'), '文化・工作');
+});
+
+const base: Omit<PortalCourse, 'id' | 'slotIds'> = {
+  termId: 'winter1', title: 'T', content: '', belongings: '', materials: '', targetGrades: ['小4', '小5'],
+  teacherLabel: '橋川', teacherId: 't1', billingUnits: 1, unitBasis: '標準', instructionMode: 'group', status: 'ready',
+};
+const days = (start: string, end: string) => ['21', '22', '23'].map(d => `2026-12-${d}@${start}-${end}`);
+
+test('講座状態: 受付中・満席・締切（手動）・準備中を区別し、残席は実数から計算', () => {
+  const body = { courses: [
+    { ...base, id: 'open', slotIds: days('09:00', '10:30') },
+    { ...base, id: 'full', slotIds: days('10:30', '12:00') },
+    { ...base, id: 'closed', slotIds: days('12:30', '14:00') },
+    { ...base, id: 'draft', slotIds: days('14:00', '15:30'), status: 'draft' as const },
+    { ...base, id: 'oneoff', slotIds: ['2026-12-21@15:30-17:00'] },
+    { ...base, id: 'indiv', slotIds: days('15:30', '17:00'), instructionMode: 'individual' as const },
+    { ...base, id: 'gone', slotIds: days('15:30', '17:00'), status: 'cancelled' as const },
+  ] };
+  const v = buildCatalog({
+    body, teachers: { t1: '橋川' },
+    controls: [
+      { courseId: 'full', capacity: 2, manualState: 'open', priceMultiplier: null, subject: null, revision: 1 },
+      { courseId: 'closed', capacity: null, manualState: 'closed', priceMultiplier: null, subject: null, revision: 1 },
+    ],
+    counts: { open: 5, full: 2, indiv: 1 },
+    settings: { phase: 'open', closesAt: null, revision: 1 }, now: new Date('2026-11-01T00:00:00Z'),
+  });
+  const by = Object.fromEntries(v.map(c => [c.id, c])) as Record<string, CourseView>;
+  assert.equal(by.gone, undefined);
+  assert.equal(by.open.status, 'open');
+  assert.equal(by.open.capacity, 12);
+  assert.equal(by.open.remaining, 7);
+  assert.equal(by.full.status, 'full');
+  assert.equal(by.full.remaining, 0);
+  assert.equal(by.closed.status, 'closed');
+  assert.equal(by.closed.remaining, 12); // 手動締切は満席とは別。残席は残る
+  assert.equal(by.draft.status, 'preparing');
+  assert.equal(by.oneoff.status, 'preparing'); // 1回だけの講座は倍率を自動で決めない
+  assert.match(by.oneoff.issues.join(), /標準と異なります/);
+  assert.equal(by.indiv.capacity, 3);
+  assert.equal(by.indiv.remaining, 2);
+  assert.equal(by.indiv.priceMultiplier, 1.4);
+  assert.equal(by.indiv.teacher, '橋川先生');
+  // 保護者向けには職員用の理由を含めない
+  assert.equal('issues' in toPublicCourse(by.oneoff), false);
+  assert.equal(toPublicCourse(by.draft).remaining, 0);
+});
+
+test('受付期間外・締切日時を過ぎたら全講座を締切にする', () => {
+  const body = { courses: [{ ...base, id: 'a', slotIds: days('09:00', '10:30') }] };
+  const mk = (phase: 'preparing' | 'open' | 'closed', closesAt: string | null) => buildCatalog({
+    body, teachers: { t1: '橋川' }, controls: [], counts: {},
+    settings: { phase, closesAt, revision: 1 }, now: new Date('2026-11-20T12:00:00Z'),
+  })[0].status;
+  assert.equal(mk('preparing', null), 'preparing');
+  assert.equal(mk('open', '2026-11-20T11:59:00Z'), 'closed');
+  assert.equal(mk('open', '2026-11-21T00:00:00Z'), 'open');
+  assert.equal(mk('closed', null), 'closed');
+});
+
+test('同じお子さんの日時重複・対象学年外を拒否する', () => {
+  const body = { courses: [
+    { ...base, id: 'a', slotIds: days('09:00', '10:30') },
+    { ...base, id: 'b', slotIds: ['2026-12-22@10:00-11:30', '2026-12-23@12:30-14:00', '2026-12-24@09:00-10:30'], termId: 'winter1' },
+    { ...base, id: 'c', slotIds: days('10:30', '12:00') },
+    { ...base, id: 'hs', slotIds: days('12:30', '14:00'), targetGrades: ['高1'] },
+  ] };
+  const catalog = new Map(buildCatalog({
+    body, teachers: { t1: '橋川' }, controls: [], counts: {},
+    settings: { phase: 'open', closesAt: null, revision: 1 }, now: new Date('2026-11-01T00:00:00Z'),
+  }).map(c => [c.id, c]));
+  assert.deepEqual(checkChildSelection('小4', ['a', 'c'], catalog), { ok: true });
+  const overlap = checkChildSelection('小4', ['a', 'b'], catalog);
+  assert.equal(overlap.ok, false);
+  assert.equal(overlap.ok === false && overlap.code, 'overlap');
+  const grade = checkChildSelection('小4', ['hs'], catalog);
+  assert.equal(grade.ok === false && grade.code, 'grade');
+});
