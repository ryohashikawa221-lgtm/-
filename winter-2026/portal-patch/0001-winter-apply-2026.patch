+export type AdminResult<T> = { ok: true; data: T } | { ok: false; error: string };
+export type DemoActor = 'principal' | 'office';
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+async function context(permission: 'seasonal_applications.view' | 'seasonal_applications.manage', demoActor?: DemoActor) {
+  const backend = await seasonalApplyBackend();
+  if (backend.demo) {
+    // 確認環境だけ: 確認用の職員（校長／閲覧のみの事務職員）を切り替えて権限の違いを確かめられる
+    return { backend, actorId: demoActor === 'office' ? DEMO_IDS.office : DEMO_IDS.principal };
+  }
+  const auth = await authorizeStaff(permission);
+  if (!auth.ok) throw new Error(auth.error);
+  return { backend, actorId: auth.session.userId };
+}
+
+function fail(e: unknown): { ok: false; error: string } {
+  const msg = e instanceof Error ? e.message : String(e);
+  // DB の例外文をそのまま職員へ見せる（内部情報は含まれない日本語メッセージのみ）。英語の内部エラーは置き換える。
+  return { ok: false, error: /[ぁ-んァ-ン一-龥]/.test(msg) ? msg.replace(/^.*?ERROR:\s*/, '') : '保存できませんでした。画面を読み込み直してから、もう一度お試しください。' };
+}
+
+export async function adminLoad(demoActor?: DemoActor): Promise<AdminResult<AdminBoard>> {
+  try {
+    const { backend, actorId } = await context('seasonal_applications.view', demoActor);
+    return { ok: true, data: await loadAdminBoard(backend.rpc, backend.campusId, actorId) };
+  } catch (e) { return fail(e); }
+}
+
+export async function adminUpdateSettings(operationId: string, expectedRevision: number, phase: PlanPhase, closesAt: string | null, reason: string, demoActor?: DemoActor): Promise<AdminResult<true>> {
+  try {
+    if (!UUID.test(operationId)) throw new Error('操作IDが不正です');
+    if (!['preparing', 'open', 'closed'].includes(phase)) throw new Error('受付状態が不正です');
+    if (closesAt != null && Number.isNaN(Date.parse(closesAt))) throw new Error('締切日時を確認してください');
+    const { backend, actorId } = await context('seasonal_applications.manage', demoActor);
+    await updateSettings(backend.rpc, backend.campusId, actorId, operationId, expectedRevision, phase, closesAt, String(reason ?? '').slice(0, 300));
+    return { ok: true, data: true };
+  } catch (e) { return fail(e); }
+}
+
+export async function adminUpdateCourse(operationId: string, courseId: string, expectedRevision: number, patch: CoursePatch, demoActor?: DemoActor): Promise<AdminResult<{ overCapacity: boolean; applied: number; capacity: number }>> {
+  try {
+    if (!UUID.test(operationId) || !UUID.test(courseId)) throw new Error('操作IDが不正です');
+    const clean: CoursePatch = {};
+    if ('capacity' in patch) clean.capacity = patch.capacity == null ? null : Number(patch.capacity);
+    if ('manualState' in patch) clean.manualState = patch.manualState === 'closed' ? 'closed' : 'open';
+    if ('priceMultiplier' in patch) clean.priceMultiplier = patch.priceMultiplier == null ? null : Number(patch.priceMultiplier);
+    if ('subject' in patch) clean.subject = patch.subject ? String(patch.subject).slice(0, 20) : null;
+    clean.reason = String(patch.reason ?? '').slice(0, 300);
+    const { backend, actorId } = await context('seasonal_applications.manage', demoActor);
+    const r = await updateCourseControl(backend.rpc, backend.campusId, actorId, operationId, courseId, expectedRevision, clean);
+    return { ok: true, data: { overCapacity: r.overCapacity, applied: r.applied, capacity: r.capacity } };
+  } catch (e) { return fail(e); }
+}
+
+export async function adminModifyApplication(operationId: string, args: {
+  applicationId: string; expectedRevision: number; cancelItemIds: string[]; add: Array<{ childId: string; courseId: string }>; reason: string;
+}, demoActor?: DemoActor): Promise<AdminResult<true>> {
+  try {
+    if (!UUID.test(operationId) || !UUID.test(args.applicationId)) throw new Error('操作IDが不正です');
+    if (![...args.cancelItemIds, ...args.add.flatMap(a => [a.childId, a.courseId])].every(x => UUID.test(x))) throw new Error('講座の指定が不正です');
+    const { backend, actorId } = await context('seasonal_applications.manage', demoActor);
+    await modifyApplication(backend.rpc, backend.campusId, actorId, operationId, { ...args, reason: String(args.reason ?? '').slice(0, 300) });
+    return { ok: true, data: true };
+  } catch (e) { return fail(e); }
+}
+
+export async function adminCsv(demoActor?: DemoActor): Promise<AdminResult<string>> {
+  try {
+    const { backend, actorId } = await context('seasonal_applications.view', demoActor);
+    return { ok: true, data: applicationsCsv(await loadAdminBoard(backend.rpc, backend.campusId, actorId)) };
+  } catch (e) { return fail(e); }
+}
