+import 'server-only';
+/**
+ * 冬期講習申込の DB 接続口（サーバー専用）。
+ * - 通常: Supabase service_role の rpc。校舎は PORTAL_CAMPUS_CODE（既定 MI）。
+ * - 確認環境: SEASONAL_APPLY_DEMO=1 のときだけ、プロセス内の PGlite に同じ migration を適用して使う。
+ *   本番 Supabase を指す設定では起動しない（誤って確認モードで本番公開しないため）。
+ */
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { admin } from './supabase-admin';
+import type { Rpc } from './seasonal-apply-service';
+import type { PortalCourse } from './seasonal-apply-catalog';
+import { DEMO_GRANT_OFFICE_VIEW, DEMO_IDS, demoDatabaseSql, sqlRpc, verificationBody, type DemoScenario } from './seasonal-apply-demo-db';
+
+const PRODUCTION_PROJECT_REF = 'gcbmwydxaanfdttmnyeu';
+const CAMPUS_CODE = process.env.PORTAL_CAMPUS_CODE ?? 'MI';
+
+export type SeasonalApplyBackend = { rpc: Rpc; campusId: string; demo: null | { scenario: DemoScenario } };
+
+export function seasonalApplyDemoEnabled(): boolean {
+  if (process.env.SEASONAL_APPLY_DEMO !== '1') return false;
+  // 確認モードは Supabase の設定が一切ない環境でだけ動かす（本番・検証用 DB の鍵がある環境では起動しない）
+  if ((process.env.NEXT_PUBLIC_SUPABASE_URL ?? '').includes(PRODUCTION_PROJECT_REF)
+    || process.env.SUPABASE_SERVICE_ROLE_KEY || process.env.NEXT_PUBLIC_SUPABASE_URL) {
+    throw new Error('確認モード（SEASONAL_APPLY_DEMO=1）は Supabase の接続設定と同時に使えません');
+  }
+  return true;
+}
+
+type DemoState = { rpc: Rpc; scenario: DemoScenario };
+const g = globalThis as unknown as { __seasonalApplyDemo?: Promise<DemoState> };
+
+async function demoBackend(): Promise<DemoState> {
+  if (!g.__seasonalApplyDemo) {
+    g.__seasonalApplyDemo = (async () => {
+      // 確認環境だけで使う。バンドラーに WASM を取り込ませず、Node の通常の解決で読み込む（next.config は変更しない）。
+      const specifier = ['@electric-sql', 'pglite'].join('/');
+      const { PGlite } = (await import(/* webpackIgnore: true */ /* turbopackIgnore: true */ specifier)) as typeof import('@electric-sql/pglite');
+      const root = process.cwd();
+      const migration = readFileSync(join(root, 'supabase/migrations/20261021090000_seasonal_apply_capacity.sql'), 'utf8');
+      const snap = JSON.parse(readFileSync(join(root, 'scripts/seasonal-apply-demo/portal-catalog-2026-10-20.json'), 'utf8')) as {
+        courses: PortalCourse[]; teachers: Record<string, string>; afternoonStart: string;
+      };
+      const scenario: DemoScenario = process.env.SEASONAL_APPLY_DEMO_SCENARIO === 'verification' ? 'verification' : 'portal';
+      const db = new PGlite();
+      const courses = scenario === 'verification' ? verificationBody(snap.courses) : snap.courses;
+      await db.exec(demoDatabaseSql(migration, { body: { courses, afternoonStart: snap.afternoonStart }, teachers: snap.teachers, published: true }));
+      await db.exec(DEMO_GRANT_OFFICE_VIEW); // 事務職員＝閲覧のみ（権限の違いを確認するため）
+      // 確認環境は最初から受付中にしておく（職員画面で「準備中」「受付終了」に切り替えて確認できる）
+      await db.query(`select public.portal_seasonal_apply_settings_update($1,$2,gen_random_uuid(),0,'open',null,'確認環境の初期設定')`, [DEMO_IDS.campus, DEMO_IDS.principal]);
+      return { rpc: sqlRpc((sql, params) => db.query(sql, params) as never), scenario };
+    })();
+  }
+  return g.__seasonalApplyDemo;
+}
+
+let campusCache: string | null = null;
+
+export async function seasonalApplyBackend(): Promise<SeasonalApplyBackend> {
+  if (seasonalApplyDemoEnabled()) {
+    const d = await demoBackend();
+    return { rpc: d.rpc, campusId: DEMO_IDS.campus, demo: { scenario: d.scenario } };
+  }
+  const sb = admin();
+  if (!campusCache) {
+    const c = await sb.from('campuses').select('id').eq('code', CAMPUS_CODE).maybeSingle();
+    if (c.error || !c.data) throw new Error('校舎データが見つかりません');
+    campusCache = c.data.id as string;
+  }
+  const rpc: Rpc = async (fn, args) => {
+    const r = await sb.rpc(fn, args);
+    if (r.error) throw new Error(r.error.message);
+    return r.data;
+  };
+  return { rpc, campusId: campusCache, demo: null };
+}
diff --git a/lib/seasonal-apply-service.ts b/lib/seasonal-apply-service.ts
new file mode 100644
